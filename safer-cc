def process(source: bytes, emit_preamble: bool = True,
            handler: str = DEFAULT_HANDLER) -> str:
    """Parse and rewrite a preprocessed C source."""
    # Strip __attribute__((...)) and @ suppression markers.
    # Spaces preserve byte offsets so rewrite spans apply to the original.
    stripped, suppressed = preprocess_source(source)

    parser = Parser(Language(tree_sitter_c.language()))
    tree = parser.parse(stripped)

    global_ptrs = PointerTracker()
    global_ptrs.scan(tree.root_node, global_only=True)

    rewriter = Rewriter(source, suppressed)
    root = tree.root_node
    result_text = transform(root, rewriter, global_ptrs)
    if result_text is not None:
        # Preserve content before and after the AST root (leading/trailing whitespace, #line directives)
        prefix = rewriter._strip_markers(0, root.start_byte)
        suffix = rewriter._strip_markers(root.end_byte, len(source))
        result = prefix + result_text + suffix
    else:
        result = rewriter._strip_markers(0, len(source))

    if emit_preamble:
        return make_preamble(handler) + result
    else:
        return result


def main_filter():
    """Filter mode: read preprocessed C, write rewritten C (for tests)."""
    ap = argparse.ArgumentParser(
        description="safer-cc filter mode — rewrite preprocessed C with safety checks",
        epilog="Reads preprocessed C from stdin or file, writes instrumented C to stdout.",
    )
    ap.add_argument("input", nargs="?", default="-",
                    help="Input file (default: stdin)")
    ap.add_argument("-o", "--output", default="-",
                    help="Output file (default: stdout)")
    ap.add_argument("--no-preamble", action="store_true",
                    help="Don't emit the ckd_* macro preamble")
    ap.add_argument("--handler", metavar="FILE",
                    help="File containing the C expression/statement to execute "
                         "on overflow (default: __builtin_trap())")
    args = ap.parse_args()

    handler = DEFAULT_HANDLER
    if args.handler is not None:
        with open(args.handler, "r") as f:
            handler = f.read().strip()

    if args.input == "-":
        source = sys.stdin.buffer.read()
    else:
        with open(args.input, "rb") as f:
            source = f.read()

    result = process(source, emit_preamble=not args.no_preamble,
                     handler=handler)

    if args.output == "-":
        sys.stdout.write(result)
    else:
        with open(args.output, "w") as f:
            f.write(result)


def main_cc():
    """Compiler wrapper mode: preprocess → rewrite → compile in one step.

    Usage: safer-cc --cc=clang [--handler=file] [cc flags...] -c source.c -o output.o
    """
    import subprocess
    import tempfile
    import os

    argv = sys.argv[1:]

    # Extract safer-cc's own flags (--cc, --handler) from the cc flags
    cc = None
    handler_file = None
    cc_args = []
    i = 0
    while i < len(argv):
        if argv[i].startswith("--cc="):
            cc = argv[i][5:]
        elif argv[i] == "--cc" and i + 1 < len(argv):
            cc = argv[i + 1]
            i += 1
        elif argv[i].startswith("--handler="):
            handler_file = argv[i][10:]
        elif argv[i] == "--handler" and i + 1 < len(argv):
            handler_file = argv[i + 1]
            i += 1
        else:
            cc_args.append(argv[i])
        i += 1

    if cc is None:
        sys.stderr.write("safer-cc: error: --cc=<compiler> is required\n")
        sys.exit(1)

    handler = DEFAULT_HANDLER
    if handler_file is not None:
        with open(handler_file, "r") as f:
            handler = f.read().strip()

    # Find the source file and -o output in the cc args.
    # We need to separate preprocessor flags from compile flags.
    source_file = None
    output_file = None
    has_c_flag = False
    other_args = []
    i = 0
    while i < len(cc_args):
        if cc_args[i] == "-o" and i + 1 < len(cc_args):
            output_file = cc_args[i + 1]
            i += 2
            continue
        elif cc_args[i] == "-c":
            has_c_flag = True
            i += 1
            continue
        elif (not cc_args[i].startswith("-") and
              cc_args[i].endswith((".c", ".h", ".i"))):
            source_file = cc_args[i]
            i += 1
            continue
        else:
            other_args.append(cc_args[i])
        i += 1

    if source_file is None:
        sys.stderr.write("safer-cc: error: no source file found in arguments\n")
        sys.exit(1)

    if not has_c_flag:
        sys.stderr.write("safer-cc: error: -c flag required (safer-cc only does compilation, not linking)\n")
        sys.exit(1)

    if output_file is None:
        # Default: source.c → source.o
        output_file = os.path.splitext(source_file)[0] + ".o"

    tmpdir = tempfile.mkdtemp(prefix="safer-cc-")
    pp_file = os.path.join(tmpdir, "pp.i")
    rewritten_file = os.path.join(tmpdir, "rewritten.c")

    try:
        # Separate dependency-generation flags from other flags.
        # Preprocessing handles deps (it sees the real source/includes).
        # Compilation must not (it would reference temp paths).
        # The compile step re-preprocesses with -x c (needed because
        # our preamble injects #define macros). Strip only dep-generation
        # flags to avoid a second .d file overwriting the correct one.
        dep_flags = {"-MMD", "-MD", "-MP", "-MG"}
        dep_with_arg = {"-MF", "-MQ", "-MT"}

        pp_args = list(other_args)
        compile_args = []
        i = 0
        while i < len(other_args):
            arg = other_args[i]
            if arg in dep_flags:
                i += 1
                continue
            if arg in dep_with_arg and i + 1 < len(other_args):
                i += 2
                continue
            if any(arg.startswith(p) for p in dep_with_arg):
                i += 1
                continue
            compile_args.append(arg)
            i += 1

        # Point dependency output to sit next to the final .o,
        # and set the target to the .o file (not the temp pp.i).
        dep_file = os.path.splitext(output_file)[0] + ".d"
        pp_args += ["-MF", dep_file, "-MT", output_file]

        # Step 1: Preprocess
        pp_cmd = [cc] + pp_args + ["-E", source_file, "-o", pp_file]
        ret = subprocess.run(pp_cmd)
        if ret.returncode != 0:
            sys.exit(ret.returncode)

        # Step 2: Rewrite
        with open(pp_file, "rb") as f:
            source = f.read()
        result = process(source, emit_preamble=True, handler=handler)
        with open(rewritten_file, "w") as f:
            f.write(result)

        # Step 3: Compile (-x c so the preamble #defines get expanded)
        compile_cmd = [cc] + compile_args + ["-c", "-x", "c",
                       rewritten_file, "-o", output_file]
        ret = subprocess.run(compile_cmd)
        sys.exit(ret.returncode)

    finally:
        import shutil
        shutil.rmtree(tmpdir, ignore_errors=True)


def main():
    # If --cc is anywhere in argv, use compiler wrapper mode.
    # Otherwise, use filter mode (for tests and piped usage).
    if any(arg.startswith("--cc") for arg in sys.argv[1:]):
        main_cc()
    else:
        main_filter()


if __name__ == "__main__":
    main()
