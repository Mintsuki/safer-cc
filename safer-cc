#!/usr/bin/env python3
"""safer-cc - Checked C Compiler Wrapper

A compile-time source rewriting tool that instruments C code with runtime
safety checks. Can be used as a compiler wrapper or as a standalone filter.

Usage:
  Compiler wrapper: safer-cc --cc=clang [--handler=file] [cc flags] -c src.c -o out.o
  Filter mode:      safer-cc [--no-preamble] [--handler=file] [input] [-o output]

Checks:
  Arithmetic:    +, -, *           overflow via __builtin_*_overflow
  Division:      /, %              division by zero + signed TYPE_MIN/-1
  Shifts:        <<, >>            shift amount out of range (uses promoted width)
  Negation:      -x                signed overflow (-INT_MIN)
  Pointers:      ptr+i, ptr-i     null pointer + wrap detection
  Pointer diff:  ptr1-ptr2        ptrdiff_t overflow
  Bounds:        arr[i]           array index vs known size (VLA/multi-dim/param arrays)
  Narrowing:     int x = long_val  truncation on any integer type conversion
                 (init, assign, return, struct field, compound assign, func arg, cast)
  Compound:      x += y           single-eval via ckd_compound, with narrowing
  Increments:    ++, --            single-eval, checked (integer and pointer)

Skips:
  - Both operands are compile-time constants
  - Expressions inside sizeof() / _Alignof()
  - Operations with @ suppression marker (e.g. a @+ b, arr@[i], @(uint8_t)x)
  - File-scope initializers (statement expressions invalid there)

Scoping:
  - Per-function and per-block variable tracking
  - Function prototype/pointer type parameters don't pollute other scopes
"""

import sys
import argparse
from tree_sitter import Language, Parser, Node
import tree_sitter_c

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

# Node types that represent compile-time constants
CONST_TYPES = frozenset({
    "number_literal",
    "char_literal",
})

# Node types for expressions we should never rewrite inside
SKIP_PARENT_TYPES = frozenset({
    "sizeof_expression",
    "alignof_expression",
})

# Operators we rewrite for binary_expression
ARITH_BINARY_OPS = {"+", "-", "*", "/", "%", "<<", ">>"}

# Compound assignment operators we rewrite
ARITH_ASSIGN_OPS = {"+=", "-=", "*=", "/=", "%=", "<<=", ">>="}

# Map from operator to macro name (binary): (integer_macro, pointer_macro)
BINARY_OP_MACRO = {
    "+": ("ckd_add", "ckd_ptr_add"),
    "-": ("ckd_sub", "ckd_ptr_sub"),
    "*": ("ckd_mul", None),
    "/": ("ckd_div", None),
    "%": ("ckd_mod", None),
    "<<": ("ckd_shl", None),
    ">>": ("ckd_shr", None),
}

# Update/increment operator macros: (int_pre, int_post, ptr_pre, ptr_post)
UPDATE_MACRO = {
    "++": ("ckd_preinc", "ckd_postinc", "ckd_ptr_preinc", "ckd_ptr_postinc"),
    "--": ("ckd_predec", "ckd_postdec", "ckd_ptr_predec", "ckd_ptr_postdec"),
}

# ---------------------------------------------------------------------------
# The preamble that defines all ckd_* macros
# ---------------------------------------------------------------------------

DEFAULT_HANDLER = "__builtin_trap()"

PREAMBLE_TEMPLATE = r"""
/* --- safer-cc: checked arithmetic preamble --- */

#ifndef SAFER_CC_PREAMBLE_
#define SAFER_CC_PREAMBLE_

/* Token pasting helpers for __COUNTER__-based unique names.
   Double indirection forces __COUNTER__ expansion before paste. */
#define ckd_paste_(a, b) a##b
#define ckd_paste(a, b) ckd_paste_(a, b)

/* Overflow handler — invoked when a checked operation overflows.
   Parameters: op = string literal ("add", "sub", "mul", "ptr add", "ptr sub"),
               col = integer literal for column offset in original source.
   Override by passing --handler <file> to safer-cc. */
#define ckd_overflow_handler_(op, col) {handler}

/* --- Core checked integer arithmetic (uses __builtin_*_overflow) --- */

#define ckd_add(a, b, col) ckd_add_(a, b, col, __COUNTER__)
#define ckd_add_(a, b, col, c) ckd_add_impl_(a, b, col, c)
#define ckd_add_impl_(a, b, col, c) __extension__({{ \
    __auto_type ckd_paste(ckd_a_, c) = (a); \
    __auto_type ckd_paste(ckd_b_, c) = (b); \
    typeof(ckd_paste(ckd_a_, c) + ckd_paste(ckd_b_, c)) ckd_paste(ckd_r_, c); \
    if (__builtin_add_overflow(ckd_paste(ckd_a_, c), ckd_paste(ckd_b_, c), \
                               &ckd_paste(ckd_r_, c))) \
        ckd_overflow_handler_("addition", col); \
    ckd_paste(ckd_r_, c); \
}})

#define ckd_sub(a, b, col) ckd_sub_(a, b, col, __COUNTER__)
#define ckd_sub_(a, b, col, c) ckd_sub_impl_(a, b, col, c)
#define ckd_sub_impl_(a, b, col, c) __extension__({{ \
    __auto_type ckd_paste(ckd_a_, c) = (a); \
    __auto_type ckd_paste(ckd_b_, c) = (b); \
    typeof(ckd_paste(ckd_a_, c) - ckd_paste(ckd_b_, c)) ckd_paste(ckd_r_, c); \
    if (__builtin_sub_overflow(ckd_paste(ckd_a_, c), ckd_paste(ckd_b_, c), \
                               &ckd_paste(ckd_r_, c))) \
        ckd_overflow_handler_("subtraction", col); \
    ckd_paste(ckd_r_, c); \
}})

#define ckd_mul(a, b, col) ckd_mul_(a, b, col, __COUNTER__)
#define ckd_mul_(a, b, col, c) ckd_mul_impl_(a, b, col, c)
#define ckd_mul_impl_(a, b, col, c) __extension__({{ \
    __auto_type ckd_paste(ckd_a_, c) = (a); \
    __auto_type ckd_paste(ckd_b_, c) = (b); \
    typeof(ckd_paste(ckd_a_, c) * ckd_paste(ckd_b_, c)) ckd_paste(ckd_r_, c); \
    if (__builtin_mul_overflow(ckd_paste(ckd_a_, c), ckd_paste(ckd_b_, c), \
                               &ckd_paste(ckd_r_, c))) \
        ckd_overflow_handler_("multiplication", col); \
    ckd_paste(ckd_r_, c); \
}})

/* --- Pointer arithmetic (null + wrap detection) --- */

/* __builtin_classify_type returns 5 for pointers. Using this for the null
   check avoids (void*) casts on non-pointer types that may leak through
   due to tracker limitations. The compiler evaluates it at compile time
   and eliminates the dead branch. */
#define ckd_nullptr_check_(val, col) \
    if (__builtin_classify_type(val) == 5 && !(val)) \
        ckd_overflow_handler_("null pointer arithmetic", col)

#define ckd_ptr_add(p, i, col) ckd_ptr_add_(p, i, col, __COUNTER__)
#define ckd_ptr_add_(p, i, col, c) ckd_ptr_add_impl_(p, i, col, c)
#define ckd_ptr_add_impl_(p, i, col, c) __extension__({{ \
    __auto_type ckd_paste(ckd_p_, c) = (p); \
    __auto_type ckd_paste(ckd_i_, c) = (i); \
    ckd_nullptr_check_(ckd_paste(ckd_p_, c), col); \
    typeof(ckd_paste(ckd_p_, c) + ckd_paste(ckd_i_, c)) ckd_paste(ckd_r_, c) = \
        ckd_paste(ckd_p_, c) + ckd_paste(ckd_i_, c); \
    if ((__INTPTR_TYPE__)ckd_paste(ckd_i_, c) >= 0 \
        ? (__UINTPTR_TYPE__)ckd_paste(ckd_r_, c) < (__UINTPTR_TYPE__)ckd_paste(ckd_p_, c) \
        : (__UINTPTR_TYPE__)ckd_paste(ckd_r_, c) > (__UINTPTR_TYPE__)ckd_paste(ckd_p_, c)) \
        ckd_overflow_handler_("pointer addition", col); \
    ckd_paste(ckd_r_, c); \
}})

#define ckd_ptr_sub(p, i, col) ckd_ptr_sub_(p, i, col, __COUNTER__)
#define ckd_ptr_sub_(p, i, col, c) ckd_ptr_sub_impl_(p, i, col, c)
#define ckd_ptr_sub_impl_(p, i, col, c) __extension__({{ \
    __auto_type ckd_paste(ckd_p_, c) = (p); \
    __auto_type ckd_paste(ckd_i_, c) = (i); \
    ckd_nullptr_check_(ckd_paste(ckd_p_, c), col); \
    typeof(ckd_paste(ckd_p_, c) - ckd_paste(ckd_i_, c)) ckd_paste(ckd_r_, c) = \
        ckd_paste(ckd_p_, c) - ckd_paste(ckd_i_, c); \
    if ((__INTPTR_TYPE__)ckd_paste(ckd_i_, c) >= 0 \
        ? (__UINTPTR_TYPE__)ckd_paste(ckd_r_, c) > (__UINTPTR_TYPE__)ckd_paste(ckd_p_, c) \
        : (__UINTPTR_TYPE__)ckd_paste(ckd_r_, c) < (__UINTPTR_TYPE__)ckd_paste(ckd_p_, c)) \
        ckd_overflow_handler_("pointer subtraction", col); \
    ckd_paste(ckd_r_, c); \
}})

/* --- Pointer-pointer subtraction (ptrdiff_t overflow) --- */

#define ckd_ptr_diff(a, b, col) ckd_ptr_diff_(a, b, col, __COUNTER__)
#define ckd_ptr_diff_(a, b, col, c) ckd_ptr_diff_impl_(a, b, col, c)
#define ckd_ptr_diff_impl_(a, b, col, c) __extension__({{ \
    __auto_type ckd_paste(ckd_a_, c) = (a); \
    __auto_type ckd_paste(ckd_b_, c) = (b); \
    ckd_nullptr_check_(ckd_paste(ckd_a_, c), col); \
    ckd_nullptr_check_(ckd_paste(ckd_b_, c), col); \
    __PTRDIFF_TYPE__ ckd_paste(ckd_r_, c) = ckd_paste(ckd_a_, c) - ckd_paste(ckd_b_, c); \
    if ((__UINTPTR_TYPE__)ckd_paste(ckd_a_, c) >= (__UINTPTR_TYPE__)ckd_paste(ckd_b_, c) \
        ? ckd_paste(ckd_r_, c) < 0 \
        : ckd_paste(ckd_r_, c) > 0) \
        ckd_overflow_handler_("pointer subtraction overflow", col); \
    ckd_paste(ckd_r_, c); \
}})

/* --- Division/modulo (zero + signed overflow) check --- */

#define ckd_div(a, b, col) ckd_div_(a, b, col, __COUNTER__)
#define ckd_div_(a, b, col, c) ckd_div_impl_(a, b, col, c)
#define ckd_div_impl_(a, b, col, c) __extension__({{ \
    __auto_type ckd_paste(ckd_a_, c) = (a); \
    __auto_type ckd_paste(ckd_b_, c) = (b); \
    if (ckd_paste(ckd_b_, c) == 0) \
        ckd_overflow_handler_("division by zero", col); \
    if ((typeof(ckd_paste(ckd_b_, c)))(-1) < 0 && ckd_paste(ckd_b_, c) == -1 && \
        __builtin_sub_overflow((typeof(ckd_paste(ckd_a_, c)))0, ckd_paste(ckd_a_, c), \
                               &(typeof(ckd_paste(ckd_a_, c))){{0}})) \
        ckd_overflow_handler_("signed division overflow", col); \
    ckd_paste(ckd_a_, c) / ckd_paste(ckd_b_, c); \
}})

#define ckd_mod(a, b, col) ckd_mod_(a, b, col, __COUNTER__)
#define ckd_mod_(a, b, col, c) ckd_mod_impl_(a, b, col, c)
#define ckd_mod_impl_(a, b, col, c) __extension__({{ \
    __auto_type ckd_paste(ckd_a_, c) = (a); \
    __auto_type ckd_paste(ckd_b_, c) = (b); \
    if (ckd_paste(ckd_b_, c) == 0) \
        ckd_overflow_handler_("division by zero", col); \
    if ((typeof(ckd_paste(ckd_b_, c)))(-1) < 0 && ckd_paste(ckd_b_, c) == -1 && \
        __builtin_sub_overflow((typeof(ckd_paste(ckd_a_, c)))0, ckd_paste(ckd_a_, c), \
                               &(typeof(ckd_paste(ckd_a_, c))){{0}})) \
        ckd_overflow_handler_("signed division overflow", col); \
    ckd_paste(ckd_a_, c) % ckd_paste(ckd_b_, c); \
}})

/* --- Shift range check --- */

#define ckd_shl(a, b, col) ckd_shl_(a, b, col, __COUNTER__)
#define ckd_shl_(a, b, col, c) ckd_shl_impl_(a, b, col, c)
#define ckd_shl_impl_(a, b, col, c) __extension__({{ \
    __auto_type ckd_paste(ckd_a_, c) = (a); \
    __auto_type ckd_paste(ckd_b_, c) = (b); \
    if (ckd_paste(ckd_b_, c) < 0 || \
        (__SIZE_TYPE__)ckd_paste(ckd_b_, c) >= \
            sizeof(typeof(ckd_paste(ckd_a_, c) << ckd_paste(ckd_b_, c))) * 8) \
        ckd_overflow_handler_("shift out of range", col); \
    ckd_paste(ckd_a_, c) << ckd_paste(ckd_b_, c); \
}})

#define ckd_shr(a, b, col) ckd_shr_(a, b, col, __COUNTER__)
#define ckd_shr_(a, b, col, c) ckd_shr_impl_(a, b, col, c)
#define ckd_shr_impl_(a, b, col, c) __extension__({{ \
    __auto_type ckd_paste(ckd_a_, c) = (a); \
    __auto_type ckd_paste(ckd_b_, c) = (b); \
    if (ckd_paste(ckd_b_, c) < 0 || \
        (__SIZE_TYPE__)ckd_paste(ckd_b_, c) >= \
            sizeof(typeof(ckd_paste(ckd_a_, c) >> ckd_paste(ckd_b_, c))) * 8) \
        ckd_overflow_handler_("shift out of range", col); \
    ckd_paste(ckd_a_, c) >> ckd_paste(ckd_b_, c); \
}})

/* --- Unary negation overflow check --- */

#define ckd_neg(a, col) ckd_neg_(a, col, __COUNTER__)
#define ckd_neg_(a, col, c) ckd_neg_impl_(a, col, c)
#define ckd_neg_impl_(a, col, c) __extension__({{ \
    __auto_type ckd_paste(ckd_a_, c) = (a); \
    typeof(-ckd_paste(ckd_a_, c)) ckd_paste(ckd_r_, c); \
    if (__builtin_sub_overflow( \
            (typeof(ckd_paste(ckd_a_, c)))0, ckd_paste(ckd_a_, c), \
            &ckd_paste(ckd_r_, c)) && \
        (typeof(ckd_paste(ckd_a_, c)))(-1) < 0) \
        ckd_overflow_handler_("negation overflow", col); \
    ckd_paste(ckd_r_, c); \
}})

/* --- Narrowing conversion check --- */

/* Checks that casting val to the target type doesn't lose information.
   Round-trip: (original_type)(target_type)(val) != val catches truncation. */
#define ckd_narrow(val, target_type, col) ckd_narrow_(val, target_type, col, __COUNTER__)
#define ckd_narrow_(val, target_type, col, c) ckd_narrow_impl_(val, target_type, col, c)
#define ckd_narrow_impl_(val, target_type, col, c) __extension__({{ \
    __auto_type ckd_paste(ckd_v_, c) = (val); \
    if ((typeof(ckd_paste(ckd_v_, c)))(target_type)(ckd_paste(ckd_v_, c)) \
        != ckd_paste(ckd_v_, c)) \
        ckd_overflow_handler_("narrowing conversion", col); \
    (target_type)(ckd_paste(ckd_v_, c)); \
}})

/* --- Array bounds check --- */

#define ckd_bounds(arr, idx, size, col) ckd_bounds_(arr, idx, size, col, __COUNTER__)
#define ckd_bounds_(arr, idx, size, col, c) ckd_bounds_impl_(arr, idx, size, col, c)
#define ckd_bounds_impl_(arr, idx, size, col, c) (*__extension__({{ \
    __auto_type ckd_paste(ckd_i_, c) = (idx); \
    if ((__SIZE_TYPE__)ckd_paste(ckd_i_, c) >= (__SIZE_TYPE__)(size)) \
        ckd_overflow_handler_("array out of bounds", col); \
    &(arr)[ckd_paste(ckd_i_, c)]; \
}}))

/* --- Compound assignment (single-evaluation of LHS) --- */

/* Generic compound: captures &(lhs) once, applies op(read, rhs, col), writes back.
   op is a macro name like ckd_add, ckd_ptr_add, etc. */
#define ckd_compound(lhs, op, rhs, col) ckd_compound__(lhs, op, rhs, col, __COUNTER__)
#define ckd_compound__(lhs, op, rhs, col, c) ckd_compound_impl_(lhs, op, rhs, col, c)
#define ckd_compound_impl_(lhs, op, rhs, col, c) __extension__({{ \
    typeof(&(lhs)) ckd_paste(ckd_p_, c) = &(lhs); \
    *ckd_paste(ckd_p_, c) = op(*ckd_paste(ckd_p_, c), (rhs), col); \
}})

/* Narrow compound: same, but wraps result in ckd_narrow before write-back. */
#define ckd_compound_narrow(lhs, op, rhs, type, col) \
    ckd_compound_narrow__(lhs, op, rhs, type, col, __COUNTER__)
#define ckd_compound_narrow__(lhs, op, rhs, type, col, c) \
    ckd_compound_narrow_impl_(lhs, op, rhs, type, col, c)
#define ckd_compound_narrow_impl_(lhs, op, rhs, type, col, c) __extension__({{ \
    typeof(&(lhs)) ckd_paste(ckd_p_, c) = &(lhs); \
    *ckd_paste(ckd_p_, c) = ckd_narrow(op(*ckd_paste(ckd_p_, c), (rhs), col), type, col); \
}})

/* --- Bit-field compound assignment (evaluates lhs twice — safe since
   bit-field access has no side effects). Cannot use ckd_compound because
   &(lhs) is illegal for bit-field members. --- */

#define ckd_bf_compound(lhs, op, rhs, col) ((void)((lhs) = op((lhs), (rhs), col)))
#define ckd_bf_compound_narrow(lhs, op, rhs, type, col) \
    ((void)((lhs) = ckd_narrow(op((lhs), (rhs), col), type, col)))

/* Bit-field increment/decrement (integer only — bit-fields can't be pointers). */
#define ckd_bf_preinc(a, col) ckd_bf_compound(a, ckd_add, 1, col)
#define ckd_bf_predec(a, col) ckd_bf_compound(a, ckd_sub, 1, col)

#define ckd_bf_postinc(a, col) ckd_bf_postinc_(a, col, __COUNTER__)
#define ckd_bf_postinc_(a, col, c) ckd_bf_postinc_impl_(a, col, c)
#define ckd_bf_postinc_impl_(a, col, c) __extension__({{ \
    typeof(a) ckd_paste(ckd_old_, c) = (a); \
    (a) = ckd_add((a), 1, col); \
    ckd_paste(ckd_old_, c); \
}})

#define ckd_bf_postdec(a, col) ckd_bf_postdec_(a, col, __COUNTER__)
#define ckd_bf_postdec_(a, col, c) ckd_bf_postdec_impl_(a, col, c)
#define ckd_bf_postdec_impl_(a, col, c) __extension__({{ \
    typeof(a) ckd_paste(ckd_old_, c) = (a); \
    (a) = ckd_sub((a), 1, col); \
    ckd_paste(ckd_old_, c); \
}})

/* --- Increment/decrement (integer, checked) --- */

#define ckd_preinc(a, col) ckd_compound(a, ckd_add, 1, col)
#define ckd_predec(a, col) ckd_compound(a, ckd_sub, 1, col)

#define ckd_postinc(a, col) ckd_postinc_(a, col, __COUNTER__)
#define ckd_postinc_(a, col, c) ckd_postinc_impl_(a, col, c)
#define ckd_postinc_impl_(a, col, c) __extension__({{ \
    typeof(&(a)) ckd_paste(ckd_pp_, c) = &(a); \
    __auto_type ckd_paste(ckd_old_, c) = *ckd_paste(ckd_pp_, c); \
    *ckd_paste(ckd_pp_, c) = ckd_add(*ckd_paste(ckd_pp_, c), 1, col); \
    ckd_paste(ckd_old_, c); \
}})

#define ckd_postdec(a, col) ckd_postdec_(a, col, __COUNTER__)
#define ckd_postdec_(a, col, c) ckd_postdec_impl_(a, col, c)
#define ckd_postdec_impl_(a, col, c) __extension__({{ \
    typeof(&(a)) ckd_paste(ckd_pp_, c) = &(a); \
    __auto_type ckd_paste(ckd_old_, c) = *ckd_paste(ckd_pp_, c); \
    *ckd_paste(ckd_pp_, c) = ckd_sub(*ckd_paste(ckd_pp_, c), 1, col); \
    ckd_paste(ckd_old_, c); \
}})

/* --- Increment/decrement (pointer, wrap-checked) --- */

#define ckd_ptr_preinc(a, col) ckd_compound(a, ckd_ptr_add, 1, col)
#define ckd_ptr_predec(a, col) ckd_compound(a, ckd_ptr_sub, 1, col)

#define ckd_ptr_postinc(a, col) ckd_ptr_postinc_(a, col, __COUNTER__)
#define ckd_ptr_postinc_(a, col, c) ckd_ptr_postinc_impl_(a, col, c)
#define ckd_ptr_postinc_impl_(a, col, c) __extension__({{ \
    typeof(&(a)) ckd_paste(ckd_pp_, c) = &(a); \
    __auto_type ckd_paste(ckd_old_, c) = *ckd_paste(ckd_pp_, c); \
    *ckd_paste(ckd_pp_, c) = ckd_ptr_add(*ckd_paste(ckd_pp_, c), 1, col); \
    ckd_paste(ckd_old_, c); \
}})

#define ckd_ptr_postdec(a, col) ckd_ptr_postdec_(a, col, __COUNTER__)
#define ckd_ptr_postdec_(a, col, c) ckd_ptr_postdec_impl_(a, col, c)
#define ckd_ptr_postdec_impl_(a, col, c) __extension__({{ \
    typeof(&(a)) ckd_paste(ckd_pp_, c) = &(a); \
    __auto_type ckd_paste(ckd_old_, c) = *ckd_paste(ckd_pp_, c); \
    *ckd_paste(ckd_pp_, c) = ckd_ptr_sub(*ckd_paste(ckd_pp_, c), 1, col); \
    ckd_paste(ckd_old_, c); \
}})

#endif /* SAFER_CC_PREAMBLE_ */
/* --- end safer-cc preamble --- */

"""


def make_preamble(handler: str = DEFAULT_HANDLER) -> str:
    return PREAMBLE_TEMPLATE.format(handler=handler)

# ---------------------------------------------------------------------------
# Attribute stripping
# ---------------------------------------------------------------------------

def preprocess_source(source: bytes) -> tuple[bytes, set[int]]:
    """Pre-process source for tree-sitter: strip __attribute__((...)) and
    collect @ suppression markers.

    Returns the cleaned source (same length, spaces in place of removed tokens)
    and a set of byte positions where @ markers were found. The @ is replaced
    with a space, and its position is recorded. Operations at these positions
    will not be rewritten.

    Note: In filter mode with un-preprocessed source, __attribute__ inside
    unexpanded macro arguments could shift argument boundaries when stripped.
    This is not an issue in compiler wrapper mode (macros are already expanded).
    """
    result = bytearray()
    suppressed: set[int] = set()
    i = 0
    n = len(source)

    while i < n:
        # Strip __attribute__((...))
        if source[i:i+13] == b'__attribute__' or source[i:i+12] == b'__attribute(':
            if source[i:i+13] == b'__attribute__':
                kw_len = 13
            else:
                kw_len = 11

            j = i + kw_len
            while j < n and source[j:j+1] in (b' ', b'\t', b'\n', b'\r'):
                j += 1

            if j < n and source[j:j+1] == b'(':
                depth = 1
                k = j + 1
                while k < n and depth > 0:
                    if source[k:k+1] == b'(':
                        depth += 1
                    elif source[k:k+1] == b')':
                        depth -= 1
                    k += 1

                if depth == 0:
                    span_len = k - i
                    result.extend(b' ' * span_len)
                    i = k
                    continue

        # Skip string literals (don't strip @ inside them)
        if source[i:i+1] in (b'"', b"'"):
            quote = source[i:i+1]
            result.append(source[i])
            i += 1
            while i < n and source[i:i+1] != quote:
                if source[i:i+1] == b'\\' and i + 1 < n:
                    result.append(source[i])
                    i += 1
                result.append(source[i])
                i += 1
            if i < n:
                result.append(source[i])
                i += 1
            continue

        # Strip @ suppression markers
        if source[i:i+1] == b'@':
            suppressed.add(i)
            result.append(ord(b' '))
            i += 1
            continue

        result.append(source[i])
        i += 1

    return bytes(result), suppressed


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def is_const_expr(node: Node) -> bool:
    """Check if a node is a compile-time constant expression."""
    if node.type in CONST_TYPES:
        return True
    # Parenthesized constant
    if node.type == "parenthesized_expression" and node.child_count == 3:
        return is_const_expr(node.children[1])
    # Unary minus/plus/~ on constant
    if node.type == "unary_expression" and node.child_count == 2:
        op = node.children[0]
        if op.type in ("+", "-", "~", "!"):
            return is_const_expr(node.children[1])
    # Cast of constant (but not cast to pointer — pointer arithmetic
    # needs to go through ckd_ptr_* even with constant addresses)
    if node.type == "cast_expression":
        if not has_pointer_declarator(node):
            for child in node.children:
                if child.type not in ("(", ")", "type_descriptor"):
                    return is_const_expr(child)
    # Binary expression where both operands are constant
    if node.type == "binary_expression" and node.child_count == 3:
        return is_const_expr(node.children[0]) and is_const_expr(node.children[2])
    # sizeof is always constant
    if node.type == "sizeof_expression":
        return True
    return False


def node_text(node: Node) -> str:
    return node.text.decode("utf-8", errors="replace")


def has_pointer_declarator(node: Node) -> bool:
    """Check if a declarator subtree contains a pointer_declarator ('*').
    Does not descend into expression nodes like sizeof or type descriptors
    that happen to contain pointer syntax for unrelated reasons."""
    if node.type == "pointer_declarator" or node.type == "abstract_pointer_declarator":
        return True
    # Don't recurse into expression/value nodes that aren't declarators
    if node.type in ("sizeof_expression", "alignof_expression",
                      "call_expression", "binary_expression",
                      "unary_expression", "conditional_expression",
                      "number_literal", "string_literal",
                      "parenthesized_expression"):
        return False
    for child in node.children:
        if has_pointer_declarator(child):
            return True
    return False


def extract_declarator_name(node: Node) -> str | None:
    """Extract the identifier name from a declarator subtree."""
    if node.type in ("identifier", "field_identifier"):
        return node_text(node)
    # In typedefs, the name being defined is a type_identifier inside an
    # array_declarator or pointer_declarator (e.g., typedef char symbol[])
    if node.type == "type_identifier" and node.parent is not None:
        if node.parent.type in ("array_declarator", "pointer_declarator"):
            return node_text(node)
    # Don't recurse into struct/union/enum bodies — field names inside
    # are not the declarator name we're looking for.
    if node.type in ("struct_specifier", "union_specifier", "enum_specifier",
                      "field_declaration_list"):
        return None
    for child in node.children:
        name = extract_declarator_name(child)
        if name is not None:
            return name
    return None


# ---------------------------------------------------------------------------
# Pointer symbol table
# ---------------------------------------------------------------------------

class PointerTracker:
    """Tracks type information for identifiers from declarations: pointer status,
    array sizes, declared types for narrowing, struct field types, and typedefs.
    Supports per-function and per-block scoping via copy()."""

    def __init__(self):
        self.pointer_names: set[str] = set()
        self.array_names: set[str] = set()
        self.array_sizes: dict[str, list[str | None]] = {}  # array name → dimension sizes (None = unsized)
        self.var_types: dict[str, str] = {}  # variable name → declared type text
        self.deep_pointer_names: set[str] = set()  # names where subscript yields pointer
        self.pointer_type_names: set[str] = set()  # typedefs for pointer/array types
        self.narrow_type_names: set[str] = set()  # typedefs that resolve to integer types (checked for narrowing)
        self.pointer_returning_funcs: set[str] = set()
        self.pointer_fields: set[str] = set()  # global (any struct with this ptr field)
        self.struct_pointer_fields: dict[str, set[str]] = {}  # struct name → {field names}
        self.struct_narrow_fields: dict[str, dict[str, str]] = {}  # struct name → {field → type}
        self.typedef_struct_names: dict[str, str] = {}  # typedef name → struct name (for anon structs, same as typedef name)
        self.var_struct_types: dict[str, str] = {}  # variable name → struct name
        self.func_return_type: str | None = None  # return type of current function
        self.func_param_narrow: dict[str, list[str | None]] = {}  # func name → [integer type or None per param]
        self.bitfield_fields: set[str] = set()  # global (any struct with this bit-field)
        self.struct_bitfield_fields: dict[str, set[str]] = {}  # struct name → {bit-field names}
        self.struct_fields_ordered: dict[str, list[tuple[str, str | None]]] = {}  # struct name → [(name, narrow_type_or_None)]

    def copy(self) -> "PointerTracker":
        """Create a shallow copy for function-local scoping."""
        new = PointerTracker()
        new.pointer_names = set(self.pointer_names)
        new.array_names = set(self.array_names)
        new.array_sizes = dict(self.array_sizes)
        new.deep_pointer_names = set(self.deep_pointer_names)
        new.pointer_type_names = set(self.pointer_type_names)
        new.narrow_type_names = set(self.narrow_type_names)
        new.pointer_returning_funcs = set(self.pointer_returning_funcs)
        new.pointer_fields = set(self.pointer_fields)
        new.struct_pointer_fields = {k: set(v) for k, v in self.struct_pointer_fields.items()}
        new.struct_narrow_fields = {k: dict(v) for k, v in self.struct_narrow_fields.items()}
        new.typedef_struct_names = dict(self.typedef_struct_names)
        new.var_struct_types = dict(self.var_struct_types)
        new.var_types = dict(self.var_types)
        new.func_return_type = self.func_return_type
        new.func_param_narrow = dict(self.func_param_narrow)
        new.bitfield_fields = set(self.bitfield_fields)
        new.struct_bitfield_fields = {k: set(v) for k, v in self.struct_bitfield_fields.items()}
        new.struct_fields_ordered = {k: list(v) for k, v in self.struct_fields_ordered.items()}
        return new

    def scan(self, root: Node, global_only: bool = False,
             skip_nested_blocks: bool = False):
        """Walk the AST and collect pointer-typed identifier names.
        If global_only is True, skip function_definition bodies.
        If skip_nested_blocks is True, skip nested compound_statements
        (each block creates its own scope during transform)."""
        self._visit(root, skip_func_bodies=global_only,
                    skip_nested_blocks=skip_nested_blocks,
                    scan_root=root)

    @staticmethod
    def _inside_funcptr_type(node: Node) -> bool:
        """Check if a parameter_declaration is NOT inside a function_definition's
        parameter list. Parameter names in prototypes and function pointer types
        don't declare real variables and should not pollute the pointer tracker."""
        parent = node.parent
        while parent is not None:
            if parent.type == "function_definition":
                return False
            parent = parent.parent
        return True

    def _visit(self, node: Node, skip_func_bodies: bool = False,
                skip_nested_blocks: bool = False, scan_root: Node | None = None):
        # In global_only mode, don't recurse into function bodies.
        if skip_func_bodies and node.type == "function_definition":
            self._check_func_return(node)
            self._check_func_params(node)
            return

        # In block-scan mode, don't recurse into nested compound_statements
        # or for_statements — each creates its own scope during transform.
        if (skip_nested_blocks
                and node.type in ("compound_statement", "for_statement")
                and node is not scan_root):
            return

        # Variable/parameter declarations with pointer declarators.
        # Skip parameter_declarations inside function pointer type signatures
        # (e.g. void (*fp)(int *x) — the *x is a type signature, not a variable).
        if node.type in ("declaration", "parameter_declaration", "field_declaration"):
            if node.type != "parameter_declaration" or not self._inside_funcptr_type(node):
                self._check_declaration(node)

        # Typedef: record type names that are pointers or arrays
        if node.type == "type_definition":
            self._check_typedef(node)

        # Function declarations/definitions: check return type and param types
        if node.type in ("function_definition", "declaration"):
            self._check_func_return(node)
            self._check_func_params(node)

        # Struct/union field declarations
        if node.type == "field_declaration":
            self._check_field(node)

        for child in node.children:
            self._visit(child, skip_func_bodies=skip_func_bodies,
                        skip_nested_blocks=skip_nested_blocks,
                        scan_root=scan_root)

    def _shadow_name(self, name: str):
        """Clear all tracking for a name before re-registering (handles shadowing)."""
        self.pointer_names.discard(name)
        self.array_names.discard(name)
        self.array_sizes.pop(name, None)
        self.deep_pointer_names.discard(name)
        self.var_types.pop(name, None)
        self.var_struct_types.pop(name, None)

    def _check_declaration(self, node: Node):
        """Record a declaration's type info: pointer/array status, array sizes,
        narrow type for narrowing checks, and pointer typedef resolution."""
        # Extract the type specifier text, struct name, and check pointer typedefs
        is_ptr_typedef = False
        type_text = None
        struct_type_name = None
        for child in node.children:
            if child.type in ("primitive_type", "sized_type_specifier"):
                type_text = node_text(child)
            if child.type == "type_identifier":
                type_text = node_text(child)
                if type_text in self.pointer_type_names:
                    is_ptr_typedef = True
            if child.type in ("struct_specifier", "union_specifier"):
                struct_type_name = f"__anon_{child.start_byte}"  # default: anon
                for sc in child.children:
                    if sc.type == "type_identifier":
                        struct_type_name = node_text(sc)
                        break

        # Process each declarator in the declaration (handles multi-decl
        # like "int *a, *b, c;")
        for child in node.children:
            if child.type in ("init_declarator", "pointer_declarator",
                              "array_declarator", "function_declarator",
                              "identifier"):
                name = extract_declarator_name(child)
                if name is None:
                    continue
                # Shadow any previous declaration of this name
                self._shadow_name(name)
                # Check declarator-level pointer/array info
                if has_pointer_declarator(child):
                    self.pointer_names.add(name)
                    if (self._has_array_declarator(child) or
                            self._has_nested_pointer_declarator(child)):
                        self.deep_pointer_names.add(name)
                if self._has_array_declarator(child):
                    self.array_names.add(name)
                # Record array sizes. For parameters, arr[10] or arr[static 10]
                # are still pointers in C, but we record the declared size
                # to bounds-check accesses inside the function body.
                dims = self._extract_array_dims(child)
                if dims is not None:
                    self.array_sizes[name] = dims
                # If the type is a pointer typedef, this name is a pointer
                if is_ptr_typedef:
                    self.pointer_names.add(name)
                # Record the declared type for narrowing checks.
                # For pointers and arrays, this is the element type
                # (char *buf → "char", char arr[N] → "char").
                if type_text is not None:
                    self.var_types[name] = type_text
                # Record which struct type this variable is.
                # For direct struct: struct foo *s → "foo"
                # For typedef: my_type *s → look up typedef_struct_names["my_type"]
                if struct_type_name is not None:
                    self.var_struct_types[name] = struct_type_name
                elif type_text is not None and type_text in self.typedef_struct_names:
                    self.var_struct_types[name] = self.typedef_struct_names[type_text]

    def _check_typedef(self, node: Node):
        """Record typedef names that resolve to pointer, array, or narrow types."""
        # type_definition children: typedef, TYPE_SPEC, NAME_OR_DECLARATOR, ;
        # The name can be an identifier, type_identifier, or even primitive_type
        # (tree-sitter recognizes known type names like uint16_t as primitive_type).
        name = extract_declarator_name(node)
        # Fallback: look for a primitive_type or type_identifier that ISN'T the
        # base type specifier (it's the name being defined)
        if name is None:
            base_found = False
            for child in node.children:
                if child.type in ("primitive_type", "sized_type_specifier",
                                  "struct_specifier", "union_specifier",
                                  "enum_specifier"):
                    if base_found:
                        # Second type-like node = the name being defined
                        name = node_text(child)
                        break
                    base_found = True
                if child.type == "type_identifier":
                    if base_found:
                        name = node_text(child)
                        break
                    base_found = True
        if name is None:
            return
        for child in node.children:
            if has_pointer_declarator(child) or self._has_array_declarator(child):
                self.pointer_type_names.add(name)
                return
        # Check if the typedef resolves to a narrow type
        for child in node.children:
            if child.type in ("primitive_type", "sized_type_specifier",
                              "type_identifier"):
                type_text = node_text(child)
                if type_text == name:
                    continue  # skip the name itself
                if type_text in NARROW_TYPES or type_text in self.narrow_type_names:
                    self.narrow_type_names.add(name)
                    return
        # Track typedef → struct mapping for per-struct field lookups.
        # typedef struct foo my_type → my_type → foo
        # typedef struct { ... } my_type → my_type → my_type (anon, keyed by typedef name)
        for child in node.children:
            if child.type in ("struct_specifier", "union_specifier"):
                struct_name = None
                for sc in child.children:
                    if sc.type == "type_identifier":
                        struct_name = node_text(sc)
                        break
                if struct_name is None:
                    struct_name = name  # anonymous struct → use typedef name
                self.typedef_struct_names[name] = struct_name
                return

    @staticmethod
    def _has_array_declarator(node: Node) -> bool:
        if node.type == "array_declarator":
            return True
        for child in node.children:
            if PointerTracker._has_array_declarator(child):
                return True
        return False

    @staticmethod
    def _extract_array_dims(node: Node) -> list[str | None] | None:
        """Extract dimension sizes from an array_declarator (supports multi-dim).
        Returns a list of size strings/None [outermost, ..., innermost], or None
        if no dimensions have sizes at all."""
        if node.type == "array_declarator":
            # Find this level's size expression — it's between '[' and ']'
            size = None
            inner_dims = None
            in_brackets = False
            for child in node.children:
                if child.type == "[":
                    in_brackets = True
                    continue
                if child.type == "]":
                    in_brackets = False
                    continue
                if in_brackets:
                    size = node_text(child)
                    continue
                if child.type == "array_declarator":
                    inner_dims = PointerTracker._extract_array_dims(child)
                    continue
            # size is None for unsized dimensions (int arr[], int m[][4]).
            # For multi-dim, preserve None entries so dimension indices stay aligned.
            if inner_dims is not None:
                return inner_dims + [size]
            if size is not None:
                return [size]
            return [None]  # unsized dimension — preserved for multi-dim alignment
        # Recurse through init_declarator, pointer_declarator, etc.
        for child in node.children:
            if child.type in ("array_declarator", "init_declarator",
                              "pointer_declarator"):
                result = PointerTracker._extract_array_dims(child)
                if result is not None:
                    return result
        return None

    @staticmethod
    def _has_nested_pointer_declarator(node: Node) -> bool:
        """True if declarator subtree has >=2 nested pointer_declarator levels
        (e.g. char **pp), meaning subscripting still yields a pointer."""
        if node.type in ("pointer_declarator", "abstract_pointer_declarator"):
            for child in node.children:
                if has_pointer_declarator(child):
                    return True
            return False
        for child in node.children:
            if PointerTracker._has_nested_pointer_declarator(child):
                return True
        return False

    def _check_func_return(self, node: Node):
        """Check if a function declaration/definition returns a pointer.

        Pattern: TYPE *func_name(...) — the pointer_declarator wraps
        the function_declarator."""
        for child in node.children:
            if child.type == "pointer_declarator":
                # Find the function_declarator inside
                func_name = self._find_func_name_in(child)
                if func_name is not None:
                    self.pointer_returning_funcs.add(func_name)

    def _check_func_params(self, node: Node):
        """Record integer parameter types for function declarations/definitions.
        Allows call-site narrowing checks like f(wide_val) where f takes a smaller int type."""
        # Find the function_declarator (may be nested inside pointer_declarator)
        func_decl = None
        for child in node.children:
            if child.type == "function_declarator":
                func_decl = child
                break
            if child.type == "pointer_declarator":
                # Pointer-returning function: TYPE *func(...)
                for inner in child.children:
                    if inner.type == "function_declarator":
                        func_decl = inner
                        break
                if func_decl:
                    break
        if func_decl is None:
            return

        # Get function name
        func_name = None
        param_list = None
        for child in func_decl.children:
            if child.type == "identifier":
                func_name = node_text(child)
            elif child.type == "parameter_list":
                param_list = child
        if func_name is None or param_list is None:
            return

        # Extract narrow type for each parameter
        param_types: list[str | None] = []
        for child in param_list.children:
            if child.type == "parameter_declaration":
                # Get the type specifier
                type_text = None
                is_ptr = has_pointer_declarator(child)
                is_arr = self._has_array_declarator(child)
                for tc in child.children:
                    if tc.type in ("primitive_type", "sized_type_specifier"):
                        type_text = node_text(tc)
                    elif tc.type == "type_identifier":
                        type_text = node_text(tc)
                if is_ptr or is_arr or type_text is None:
                    param_types.append(None)
                elif (type_text in NARROW_TYPES
                      or type_text in self.narrow_type_names):
                    param_types.append(type_text)
                else:
                    param_types.append(None)
            elif child.type == "variadic_parameter":
                break  # stop at ...

        if any(t is not None for t in param_types):
            self.func_param_narrow[func_name] = param_types

    def _find_func_name_in(self, node: Node) -> str | None:
        """Find a function name inside a declarator subtree."""
        if node.type == "function_declarator":
            for child in node.children:
                if child.type == "identifier":
                    return node_text(child)
                if child.type == "parenthesized_declarator":
                    name = extract_declarator_name(child)
                    if name:
                        return name
        for child in node.children:
            result = self._find_func_name_in(child)
            if result is not None:
                return result
        return None

    @staticmethod
    def _enclosing_struct_name(node: Node) -> str | None:
        """Find the struct/union name that contains this field_declaration.
        For anonymous structs inside typedefs, uses the typedef name."""
        parent = node.parent
        while parent is not None:
            if parent.type in ("struct_specifier", "union_specifier"):
                # Named struct: struct foo { ... }
                for child in parent.children:
                    if child.type == "type_identifier":
                        return node_text(child)
                # Anonymous struct — check if it's inside a typedef
                if (parent.parent is not None
                        and parent.parent.type == "type_definition"):
                    for child in parent.parent.children:
                        if child.type == "type_identifier":
                            return node_text(child)
                # Truly anonymous: use byte offset as a unique synthetic key
                return f"__anon_{parent.start_byte}"
            parent = parent.parent
        return None

    def _check_field(self, node: Node):
        """Record struct/union fields: pointer/array status, narrow types,
        bit-field status, and ordered field list for initializer list checking."""
        name = extract_declarator_name(node)
        if name is None:
            return

        struct_name = self._enclosing_struct_name(node)

        # Detect bit-field declarations (field_declaration with bitfield_clause child)
        for child in node.children:
            if child.type == "bitfield_clause":
                self.bitfield_fields.add(name)
                if struct_name is not None:
                    self.struct_bitfield_fields.setdefault(struct_name, set()).add(name)
                break

        # Check pointer/array status
        is_ptr_or_arr = False
        for child in node.children:
            if child.type in ("pointer_declarator", "array_declarator",
                              "function_declarator"):
                if has_pointer_declarator(child) or self._has_array_declarator(child):
                    is_ptr_or_arr = True
                    self.pointer_fields.add(name)
                    if struct_name is not None:
                        self.struct_pointer_fields.setdefault(struct_name, set()).add(name)
                    break
            if child.type == "type_identifier":
                if node_text(child) in self.pointer_type_names:
                    is_ptr_or_arr = True
                    self.pointer_fields.add(name)
                    if struct_name is not None:
                        self.struct_pointer_fields.setdefault(struct_name, set()).add(name)
                    break

        # Check narrow type (only for non-pointer/non-array fields)
        narrow_type = None
        if not is_ptr_or_arr and struct_name is not None:
            for child in node.children:
                if child.type in ("primitive_type", "sized_type_specifier",
                                  "type_identifier"):
                    type_text = node_text(child)
                    if type_text in NARROW_TYPES or type_text in self.narrow_type_names:
                        narrow_type = type_text
                        self.struct_narrow_fields.setdefault(struct_name, {})[name] = type_text
                        break

        # Record in ordered field list (for struct initializer list narrowing)
        if struct_name is not None:
            self.struct_fields_ordered.setdefault(struct_name, []).append((name, narrow_type))

    def is_bitfield_expr(self, node: Node) -> bool:
        """Check if this expression accesses a known bit-field member."""
        if node.type != "field_expression":
            return False
        for i, child in enumerate(node.children):
            if child.type in (".", "->") and i + 1 < len(node.children):
                field = node.children[i + 1]
                if field.type == "field_identifier":
                    field_name = node_text(field)
                    # Try per-struct lookup first
                    base = node.children[0] if i > 0 else None
                    if base is not None and base.type == "identifier":
                        sname = self.var_struct_types.get(node_text(base))
                        if sname is not None:
                            return field_name in self.struct_bitfield_fields.get(sname, set())
                    # Fallback: global bitfield_fields (unknown struct)
                    return field_name in self.bitfield_fields
        return False

    def is_pointer_expr(self, node: Node) -> bool:
        """Determine if an expression node is a pointer type."""
        # Direct identifier lookup (pointer or array — arrays decay to pointers)
        if node.type == "identifier":
            name = node_text(node)
            return name in self.pointer_names or name in self.array_names

        # String literals are pointers
        if node.type in ("string_literal", "concatenated_string"):
            return True

        # pointer_expression covers both &x (address-of) and *p (dereference)
        if node.type == "pointer_expression" and node.child_count == 2:
            op = node.children[0]
            inner = node.children[1]
            # Address-of always produces a pointer
            if op.type == "&":
                return True
            # Dereference of a pointer-to-pointer yields a pointer
            if op.type == "*" and inner.type == "identifier":
                if node_text(inner) in self.deep_pointer_names:
                    return True

        # Subscript expression: base[index] is a pointer if base has >=2
        # levels of indirection (e.g. char **pp → pp[0] is char *)
        # or is an array of pointers (e.g. char *arr[10] → arr[0] is char *)
        if node.type == "subscript_expression" and node.child_count >= 1:
            base = node.children[0]
            if base.type == "identifier":
                return node_text(base) in self.deep_pointer_names

        # Cast to pointer type
        if node.type == "cast_expression":
            for child in node.children:
                if child.type == "type_descriptor":
                    if has_pointer_declarator(child):
                        return True

        # Function call: check if the function returns a pointer
        if node.type == "call_expression" and node.child_count >= 1:
            func_node = node.children[0]
            if func_node.type == "identifier":
                if node_text(func_node) in self.pointer_returning_funcs:
                    return True

        # Member access: check if the field is a known pointer field.
        # Prefer per-struct lookup when the base variable's struct type is known.
        if node.type == "field_expression":
            for i, child in enumerate(node.children):
                if child.type in (".", "->"):
                    if i + 1 < len(node.children):
                        field = node.children[i + 1]
                        if field.type == "field_identifier":
                            field_name = node_text(field)
                            # Try per-struct lookup first
                            base = node.children[0] if i > 0 else None
                            if base is not None and base.type == "identifier":
                                sname = self.var_struct_types.get(node_text(base))
                                if sname is not None:
                                    if field_name in self.struct_pointer_fields.get(sname, set()):
                                        return True
                                    break  # known struct, field not pointer
                            # Fallback: global pointer_fields (unknown struct)
                            if field_name in self.pointer_fields:
                                return True
                    # Also: ptr->anything means the base is a pointer,
                    # but the result depends on the field type, not the base.
                    break

        # Binary +/- with a pointer operand yields a pointer
        if node.type == "binary_expression":
            for child in node.children:
                if child.type in ("+", "-"):
                    continue
                if child.type not in ("*",) and self.is_pointer_expr(child):
                    return True

        # Parenthesized pointer expr
        if node.type == "parenthesized_expression" and node.child_count == 3:
            return self.is_pointer_expr(node.children[1])

        # Conditional expression: pointer if either branch is pointer
        if node.type == "conditional_expression" and node.child_count == 5:
            return (self.is_pointer_expr(node.children[2]) or
                    self.is_pointer_expr(node.children[4]))

        # Comma expression: type of the last operand
        if node.type == "comma_expression":
            return self.is_pointer_expr(node.children[-1])

        return False


# ---------------------------------------------------------------------------
# Core rewriter
# ---------------------------------------------------------------------------

class Rewriter:
    """Holds the original source bytes and suppression markers. The recursive
    transform() / _transform_children() functions stitch rewritten text together
    directly; this class provides is_suppressed() and _strip_markers() helpers."""

    def __init__(self, source_bytes: bytes, suppressed: set[int] | None = None):
        self.source = source_bytes
        self.suppressed = suppressed or set()
        self._sorted_suppressed = sorted(self.suppressed)

    def is_suppressed(self, node: Node) -> bool:
        """Check if any @ marker is adjacent to this node's operator.

        The @ must be directly before the operator token of this specific
        node, not just anywhere within its byte range. This prevents
        a @+ b + c from suppressing the outer + as well.
        """
        # Find the operator child of this node
        op_start = None
        for child in node.children:
            if child.type in ("+", "-", "*", "/", "%", "<<", ">>",
                            "++", "--",
                            "+=", "-=", "*=", "/=", "%=", "<<=", ">>=",
                            "=", "[", "return", "("):
                op_start = child.start_byte
                break
        if op_start is None:
            return False
        # The @ must be right before the operator (possibly with spaces between,
        # but the @ was replaced with a space, so check if any suppressed
        # position is in the range [op_start - 1] or slightly before)
        for pos in self.suppressed:
            # @ is at pos, operator starts at op_start. The @ should be
            # just before the operator, possibly with whitespace between.
            # For prefix ops (++x), the @ may be just before the node itself.
            if pos < op_start and pos >= node.start_byte - 1:
                between = self.source[pos + 1:op_start]
                if all(b in b' \t' for b in between):
                    return True
        return False

    def _strip_markers(self, start: int, end: int) -> str:
        """Copy source[start:end] to string, removing @ at suppressed positions."""
        if not self._sorted_suppressed:
            return self.source[start:end].decode("utf-8", errors="replace")
        chunks = []
        i = start
        for sup in self._sorted_suppressed:
            if sup < i:
                continue
            if sup >= end:
                break
            chunks.append(self.source[i:sup])
            i = sup + 1  # skip the @
        chunks.append(self.source[i:end])
        return b''.join(chunks).decode("utf-8", errors="replace")


def transform(node: Node, rewriter: Rewriter, ptrs: PointerTracker) -> str | None:
    """Recursively transform an AST node, returning rewritten text or None.

    Returns the rewritten text if this node (or any descendant) needed
    rewriting. Returns None if the subtree is unchanged — the caller
    should use the original source bytes.
    """
    # Don't recurse into sizeof/alignof/error nodes
    if node.type in SKIP_PARENT_TYPES or node.type == "ERROR" or node.is_error:
        return None

    # When entering a function_definition, create a scoped tracker that
    # inherits file-scope names but adds the function's parameters.
    if node.type == "function_definition":
        local_ptrs = ptrs.copy()
        # Scan the declarator (parameters). For pointer-returning functions,
        # the function_declarator is nested inside a pointer_declarator.
        has_ptr_return = False
        for child in node.children:
            if child.type in ("function_declarator", "pointer_declarator"):
                local_ptrs.scan(child)
            if child.type == "pointer_declarator":
                has_ptr_return = True
        # Extract return type for narrowing on return statements.
        # Skip if the function returns a pointer (char *f() → no truncation check).
        if not has_ptr_return:
            for child in node.children:
                if child.type in ("primitive_type", "sized_type_specifier"):
                    rtype = node_text(child)
                    if rtype in NARROW_TYPES or rtype in local_ptrs.narrow_type_names:
                        local_ptrs.func_return_type = rtype
                    break
                if child.type == "type_identifier":
                    rtype = node_text(child)
                    if rtype in NARROW_TYPES or rtype in local_ptrs.narrow_type_names:
                        local_ptrs.func_return_type = rtype
                    break
        return _transform_children(node, rewriter, local_ptrs)

    # Block scoping: each compound_statement gets its own tracker copy
    # with declarations from this block only (not nested blocks).
    if node.type == "compound_statement":
        block_ptrs = ptrs.copy()
        block_ptrs.scan(node, skip_nested_blocks=True)
        return _transform_children(node, rewriter, block_ptrs)

    # For-statement scoping: the initializer declaration (e.g. int i = 0) is
    # scoped to the for-statement, not the enclosing block.
    if node.type == "for_statement":
        for_ptrs = ptrs.copy()
        for child in node.children:
            if child.type == "declaration":
                for_ptrs.scan(child)
                break
        return _transform_children(node, rewriter, for_ptrs)

    # Try to rewrite this specific node
    rewritten = try_rewrite(node, rewriter, ptrs)
    if rewritten is not None:
        return rewritten

    # Not rewritable at this level — check if any children need rewriting
    child_results = []
    any_changed = False
    for child in node.children:
        result = transform(child, rewriter, ptrs)
        if result is not None:
            child_results.append(result)
            any_changed = True
        else:
            child_results.append(None)

    if not any_changed:
        return None

    # Rebuild this node's text from a mix of rewritten and original children
    parts = []
    prev_end = node.start_byte
    for child, result in zip(node.children, child_results):
        # Gap between previous child end and this child start (whitespace, operators)
        parts.append(rewriter._strip_markers(prev_end, child.start_byte))
        if result is not None:
            parts.append(result)
        else:
            parts.append(rewriter._strip_markers(child.start_byte, child.end_byte))
        prev_end = child.end_byte
    # Trailing text after last child
    parts.append(rewriter._strip_markers(prev_end, node.end_byte))
    return "".join(parts)


def _transform_children(node: Node, rewriter: Rewriter, ptrs: PointerTracker) -> str | None:
    """Transform a node's children using the given tracker (used for scoped transforms)."""
    child_results = []
    any_changed = False
    for child in node.children:
        result = transform(child, rewriter, ptrs)
        if result is not None:
            child_results.append(result)
            any_changed = True
        else:
            child_results.append(None)

    if not any_changed:
        return None

    parts = []
    prev_end = node.start_byte
    for child, result in zip(node.children, child_results):
        parts.append(rewriter._strip_markers(prev_end, child.start_byte))
        if result is not None:
            parts.append(result)
        else:
            parts.append(rewriter._strip_markers(child.start_byte, child.end_byte))
        prev_end = child.end_byte
    parts.append(rewriter._strip_markers(prev_end, node.end_byte))
    return "".join(parts)


# Integer types that can be targets of narrowing conversions.
# Any assignment from a wider type to one of these truncates silently in C.
# The ckd_narrow macro's runtime check (round-trip cast) catches actual
# information loss; same-width assignments are optimized away by the compiler.
NARROW_TYPES = frozenset({
    "char", "signed char", "unsigned char",
    "short", "unsigned short", "short int", "unsigned short int",
    "int", "signed", "signed int", "unsigned", "unsigned int",
    "long", "signed long", "unsigned long", "long int", "unsigned long int",
    "long long", "signed long long", "unsigned long long",
    "long long int", "unsigned long long int",
})


def try_rewrite(node: Node, rewriter: Rewriter, ptrs: PointerTracker) -> str | None:
    """Try to rewrite a single node. Returns rewritten text or None."""
    if node.type == "binary_expression":
        return try_rewrite_binary(node, rewriter, ptrs)
    elif node.type == "assignment_expression":
        return try_rewrite_compound_assign(node, rewriter, ptrs)
    elif node.type == "update_expression":
        return try_rewrite_update(node, rewriter, ptrs)
    elif node.type == "unary_expression":
        return try_rewrite_unary_neg(node, rewriter, ptrs)
    elif node.type == "subscript_expression":
        return try_rewrite_subscript(node, rewriter, ptrs)
    elif node.type == "init_declarator":
        return try_rewrite_init_narrow(node, rewriter, ptrs)
    elif node.type == "return_statement":
        return try_rewrite_return_narrow(node, rewriter, ptrs)
    elif node.type == "call_expression":
        return try_rewrite_call_narrow(node, rewriter, ptrs)
    elif node.type == "cast_expression":
        return try_rewrite_cast_narrow(node, rewriter, ptrs)
    return None


def try_rewrite_binary(node: Node, rewriter: Rewriter, ptrs: PointerTracker) -> str | None:
    """Rewrite binary +, -, *, /, %, <<, >> expressions. Returns rewritten text or None."""
    if node.child_count < 3 or node.has_error or rewriter.is_suppressed(node):
        return None

    children = node.children
    op_node = None
    left_node = None
    right_node = None

    for i, child in enumerate(children):
        if child.type in ARITH_BINARY_OPS:
            op_node = child
            left_node = children[i - 1] if i > 0 else None
            right_node = children[i + 1] if i + 1 < len(children) else None
            break

    if op_node is None or left_node is None or right_node is None:
        return None

    op = node_text(op_node)
    if op not in ARITH_BINARY_OPS:
        return None

    if is_const_expr(left_node) and is_const_expr(right_node):
        return None

    macros = BINARY_OP_MACRO.get(op)
    if macros is None:
        return None

    int_macro, ptr_macro = macros
    left_is_ptr = ptrs.is_pointer_expr(left_node)
    right_is_ptr = ptrs.is_pointer_expr(right_node)

    if left_is_ptr and right_is_ptr and op == "-":
        col = node.start_point[1] + 1
        left_text = transform(left_node, rewriter, ptrs)
        if left_text is None:
            left_text = rewriter._strip_markers(left_node.start_byte, left_node.end_byte)
        right_text = transform(right_node, rewriter, ptrs)
        if right_text is None:
            right_text = rewriter._strip_markers(right_node.start_byte, right_node.end_byte)
        return f"ckd_ptr_diff({left_text}, {right_text}, {col})"

    is_ptr = (left_is_ptr or right_is_ptr)

    if is_ptr:
        if ptr_macro is None:
            return None
        macro = ptr_macro
    else:
        macro = int_macro

    col = node.start_point[1] + 1

    # Recursively transform operands first
    left_text = transform(left_node, rewriter, ptrs)
    if left_text is None:
        left_text = rewriter._strip_markers(left_node.start_byte, left_node.end_byte)
    right_text = transform(right_node, rewriter, ptrs)
    if right_text is None:
        right_text = rewriter._strip_markers(right_node.start_byte, right_node.end_byte)

    if is_ptr and op == "+" and right_is_ptr and not left_is_ptr:
        left_text, right_text = right_text, left_text

    return f"{macro}({left_text}, {right_text}, {col})"


def _get_lhs_narrow_type(left_node: Node, ptrs: PointerTracker) -> str | None:
    """Get the integer type of an assignment LHS for narrowing checks, or None.
    Checks identifiers, subscript bases, pointer dereferences, and struct fields."""
    if left_node.type == "identifier":
        name = node_text(left_node)
        if name not in ptrs.pointer_names:
            if (name in ptrs.var_types
                    and (ptrs.var_types[name] in NARROW_TYPES
                         or ptrs.var_types[name] in ptrs.narrow_type_names)):
                return ptrs.var_types[name]
    elif left_node.type == "subscript_expression" and left_node.child_count >= 1:
        base = left_node.children[0]
        if base.type == "identifier":
            name = node_text(base)
            if (name in ptrs.var_types
                    and (ptrs.var_types[name] in NARROW_TYPES
                         or ptrs.var_types[name] in ptrs.narrow_type_names)):
                return ptrs.var_types[name]
    elif left_node.type == "pointer_expression" and left_node.child_count == 2:
        if left_node.children[0].type == "*":
            inner = left_node.children[1]
            if inner.type == "identifier":
                name = node_text(inner)
                if name not in ptrs.deep_pointer_names:
                    if (name in ptrs.var_types
                            and (ptrs.var_types[name] in NARROW_TYPES
                                 or ptrs.var_types[name] in ptrs.narrow_type_names)):
                        return ptrs.var_types[name]
    elif left_node.type == "field_expression":
        for i, child in enumerate(left_node.children):
            if child.type in (".", "->") and i + 1 < len(left_node.children):
                base_node = left_node.children[0] if i > 0 else None
                field_node = left_node.children[i + 1]
                if base_node is not None and field_node.type == "field_identifier":
                    base_name = None
                    if base_node.type == "identifier":
                        base_name = node_text(base_node)
                    struct_name = ptrs.var_struct_types.get(base_name) if base_name else None
                    if struct_name is not None:
                        fields = ptrs.struct_narrow_fields.get(struct_name, {})
                        field_name = node_text(field_node)
                        if field_name in fields:
                            return fields[field_name]
                break
    return None


def try_rewrite_compound_assign(node: Node, rewriter: Rewriter, ptrs: PointerTracker) -> str | None:
    """Rewrite compound assignment and plain = (for narrowing). Returns rewritten text or None."""
    if node.child_count < 3 or node.has_error or rewriter.is_suppressed(node):
        return None

    children = node.children
    op_node = children[1]
    op = node_text(op_node)

    left_node = children[0]
    right_node = children[2]

    # Plain = assignment: check for narrowing if LHS has a narrow type
    if op == "=":
        if not is_const_expr(right_node):
            decl_type = _get_lhs_narrow_type(left_node, ptrs)
            if decl_type is not None and not (
                    right_node.type == "cast_expression"
                    and _extract_cast_type(right_node) == decl_type):
                col = right_node.start_point[1] + 1
                right_text = transform(right_node, rewriter, ptrs)
                if right_text is None:
                    right_text = rewriter._strip_markers(right_node.start_byte, right_node.end_byte)
                left_text = transform(left_node, rewriter, ptrs)
                if left_text is None:
                    left_text = rewriter._strip_markers(left_node.start_byte, left_node.end_byte)
                return f"{left_text} = ckd_narrow({right_text}, {decl_type}, {col})"
        return None

    if op not in ARITH_ASSIGN_OPS:
        return None

    if is_const_expr(left_node) and is_const_expr(right_node):
        return None

    # Derive binary operator and macro from compound operator ("+=" → "+")
    binary_op = op.rstrip("=")
    macros = BINARY_OP_MACRO.get(binary_op)
    if macros is None:
        return None

    int_macro, ptr_macro = macros
    is_ptr = ptrs.is_pointer_expr(left_node)

    if is_ptr:
        if ptr_macro is None:
            return None
        macro = ptr_macro
    else:
        macro = int_macro

    col = node.start_point[1] + 1

    left_text = transform(left_node, rewriter, ptrs)
    if left_text is None:
        left_text = rewriter._strip_markers(left_node.start_byte, left_node.end_byte)

    right_text = transform(right_node, rewriter, ptrs)
    if right_text is None:
        right_text = rewriter._strip_markers(right_node.start_byte, right_node.end_byte)

    # Bit-field members: can't take &(lhs), use ckd_bf_compound which evaluates
    # lhs twice (safe — bit-field access has no side effects).
    is_bf = ptrs.is_bitfield_expr(left_node)

    # Emit ckd_compound which captures &(lhs) once, avoiding double evaluation.
    # For narrow LHS types, also check truncation.
    if not is_ptr:
        decl_type = _get_lhs_narrow_type(left_node, ptrs)
        if decl_type is not None:
            if is_bf:
                return f"ckd_bf_compound_narrow({left_text}, {macro}, {right_text}, {decl_type}, {col})"
            return f"ckd_compound_narrow({left_text}, {macro}, {right_text}, {decl_type}, {col})"

    if is_bf:
        return f"ckd_bf_compound({left_text}, {macro}, {right_text}, {col})"
    return f"ckd_compound({left_text}, {macro}, {right_text}, {col})"


def _update_result_discarded(node: Node) -> bool:
    """Check if the result of this update expression is unused."""
    parent = node.parent
    if parent is None:
        return False
    # Standalone statement: `i++;`
    if parent.type == "expression_statement":
        return True
    # For-loop update: `for(...; ...; i++)`
    # tree-sitter puts the update as a direct child of for_statement,
    # after the second `;`
    if parent.type == "for_statement":
        return True
    # Comma expression: `j++, i++` — both sides discarded in statement context
    if parent.type == "comma_expression":
        return _update_result_discarded(parent)
    return False


def try_rewrite_update(node: Node, rewriter: Rewriter, ptrs: PointerTracker) -> str | None:
    """Rewrite ++/-- (prefix and postfix). Returns rewritten text or None."""
    if node.child_count < 2 or node.has_error or rewriter.is_suppressed(node):
        return None

    children = node.children

    if children[0].type in ("++", "--"):
        op = node_text(children[0])
        operand = children[1]
    elif children[-1].type in ("++", "--"):
        op = node_text(children[-1])
        operand = children[0]
    else:
        return None

    if operand.type not in ("identifier", "field_expression",
                            "subscript_expression", "parenthesized_expression",
                            "pointer_expression"):
        return None

    is_ptr = ptrs.is_pointer_expr(operand)
    is_bf = ptrs.is_bitfield_expr(operand)

    # Bit-field members: can't take &(lhs), use ckd_bf_ macros.
    # Bit-fields can't be pointers, so no ptr variants needed.
    if is_bf:
        if _update_result_discarded(node) or children[0].type in ("++", "--"):
            bf_macro = "ckd_bf_preinc" if op == "++" else "ckd_bf_predec"
        else:
            bf_macro = "ckd_bf_postinc" if op == "++" else "ckd_bf_postdec"
        col = node.start_point[1] + 1
        operand_text = transform(operand, rewriter, ptrs)
        if operand_text is None:
            operand_text = rewriter._strip_markers(operand.start_byte, operand.end_byte)
        return f"{bf_macro}({operand_text}, {col})"

    int_pre, int_post, ptr_pre, ptr_post = UPDATE_MACRO[op]

    if _update_result_discarded(node):
        macro = ptr_pre if is_ptr else int_pre
    elif children[0].type in ("++", "--"):
        macro = ptr_pre if is_ptr else int_pre
    else:
        macro = ptr_post if is_ptr else int_post

    col = node.start_point[1] + 1
    operand_text = transform(operand, rewriter, ptrs)
    if operand_text is None:
        operand_text = rewriter._strip_markers(operand.start_byte, operand.end_byte)
    return f"{macro}({operand_text}, {col})"


def _resolve_subscript_chain(node: Node, ptrs: PointerTracker) -> tuple[str, int] | None:
    """Walk a chain of subscript_expressions to find the base array and depth.
    Returns (array_name, depth) or None. depth 0 = first subscript."""
    if node.type == "identifier":
        name = node_text(node)
        if name in ptrs.array_sizes:
            return (name, 0)
        return None
    if node.type == "subscript_expression" and node.child_count >= 1:
        result = _resolve_subscript_chain(node.children[0], ptrs)
        if result is not None:
            return (result[0], result[1] + 1)
    return None


def try_rewrite_subscript(node: Node, rewriter: Rewriter, ptrs: PointerTracker) -> str | None:
    """Rewrite arr[idx] with bounds check when arr has a known size.
    Supports multi-dimensional arrays by walking the subscript chain.
    Returns rewritten text or None."""
    if node.child_count < 4 or node.has_error or rewriter.is_suppressed(node):
        return None

    # subscript_expression: base '[' index ']'
    base = node.children[0]
    index = None
    for child in node.children:
        if child.type not in ("[", "]") and child is not base:
            index = child
            break

    if base is None or index is None:
        return None

    # Walk the subscript chain to find the base array and nesting depth
    chain = _resolve_subscript_chain(base, ptrs)
    size = None
    if chain is not None:
        name, depth = chain
        dims = ptrs.array_sizes[name]
        if depth < len(dims):
            size = dims[depth]  # may be None for unsized dimensions
        # else: more subscripts than dimensions — no check

    if size is None:
        # No known size for this dimension — can't bounds-check,
        # but still recurse into children for inner dimensions
        return None

    col = node.start_point[1] + 1

    # Recursively transform the base (handles inner subscript bounds checks)
    base_text = transform(base, rewriter, ptrs)
    if base_text is None:
        base_text = rewriter._strip_markers(base.start_byte, base.end_byte)

    # Recursively transform the index expression
    index_text = transform(index, rewriter, ptrs)
    if index_text is None:
        index_text = rewriter._strip_markers(index.start_byte, index.end_byte)

    return f"ckd_bounds({base_text}, {index_text}, {size}, {col})"


def _extract_cast_type(node: Node) -> str | None:
    """Get the target type of a cast_expression, or None."""
    for child in node.children:
        if child.type == "type_descriptor":
            for tc in child.children:
                if tc.type in ("primitive_type", "sized_type_specifier", "type_identifier"):
                    return node_text(tc)
    return None


def _get_declaration_type(node: Node) -> str | None:
    """Get the type specifier text from a declaration or parameter_declaration parent."""
    parent = node.parent
    if parent is None:
        return None
    if parent.type in ("declaration", "parameter_declaration"):
        for child in parent.children:
            if child.type in ("primitive_type", "sized_type_specifier", "type_identifier"):
                return node_text(child)
    return None


def _get_struct_type_for_decl(node: Node, ptrs: PointerTracker) -> str | None:
    """Get the struct/union name for an init_declarator's type, or None."""
    parent = node.parent
    if parent is None or parent.type != "declaration":
        return None
    for child in parent.children:
        if child.type in ("struct_specifier", "union_specifier"):
            for sc in child.children:
                if sc.type == "type_identifier":
                    return node_text(sc)
            # Anonymous struct — use byte offset as key (matches _check_field)
            return f"__anon_{child.start_byte}"
        if child.type == "type_identifier":
            type_name = node_text(child)
            return ptrs.typedef_struct_names.get(type_name)
    return None


def _rewrite_struct_init_list(node, init_node, fields, eq_idx, rewriter, ptrs):
    """Rewrite a struct initializer list with narrowing checks on narrow-type fields."""
    elems = [c for c in init_node.children if c.type not in ("{", "}", ",")]

    # Check if any positional element needs narrowing
    any_narrow = False
    for i, elem in enumerate(elems):
        if i < len(fields) and elem.type != "initializer_list":
            _, narrow_type = fields[i]
            if narrow_type is not None and not is_const_expr(elem):
                any_narrow = True
                break
    if not any_narrow:
        return None

    # Rebuild the initializer list with ckd_narrow on narrow fields
    parts = []
    prev_end = init_node.start_byte
    field_idx = 0
    for child in init_node.children:
        parts.append(rewriter._strip_markers(prev_end, child.start_byte))
        if child.type not in ("{", "}", ","):
            narrow_type = None
            if field_idx < len(fields) and child.type != "initializer_list":
                _, narrow_type = fields[field_idx]
            field_idx += 1
            if narrow_type is not None and not is_const_expr(child):
                col = child.start_point[1] + 1
                elem_text = transform(child, rewriter, ptrs)
                if elem_text is None:
                    elem_text = rewriter._strip_markers(child.start_byte, child.end_byte)
                parts.append(f"ckd_narrow({elem_text}, {narrow_type}, {col})")
            else:
                child_text = transform(child, rewriter, ptrs)
                if child_text is not None:
                    parts.append(child_text)
                else:
                    parts.append(rewriter._strip_markers(child.start_byte, child.end_byte))
        else:
            parts.append(rewriter._strip_markers(child.start_byte, child.end_byte))
        prev_end = child.end_byte
    parts.append(rewriter._strip_markers(prev_end, init_node.end_byte))

    # Rebuild the full init_declarator
    result_parts = []
    prev_end = node.start_byte
    for child in node.children:
        result_parts.append(rewriter._strip_markers(prev_end, child.start_byte))
        if child is init_node:
            result_parts.append("".join(parts))
        else:
            result_parts.append(rewriter._strip_markers(child.start_byte, child.end_byte))
        prev_end = child.end_byte
    result_parts.append(rewriter._strip_markers(prev_end, node.end_byte))
    return "".join(result_parts)


def try_rewrite_init_narrow(node: Node, rewriter: Rewriter, ptrs: PointerTracker) -> str | None:
    """Rewrite init_declarator to add narrowing check when the declared type
    is an integer type. E.g. int x = long_val → int x = ckd_narrow(long_val, int, col)."""
    if node.child_count < 3 or node.has_error or rewriter.is_suppressed(node):
        return None

    # Skip file-scope initializers — C requires them to be constant expressions,
    # and statement expressions (ckd_narrow) aren't valid at file scope.
    # Check by looking for an enclosing compound_statement (function body).
    parent = node.parent
    inside_function = False
    while parent is not None:
        if parent.type == "compound_statement":
            inside_function = True
            break
        if parent.type == "translation_unit":
            break
        parent = parent.parent
    if not inside_function:
        return None

    # Find the = and the initializer
    eq_idx = None
    for i, child in enumerate(node.children):
        if child.type == "=":
            eq_idx = i
            break

    if eq_idx is None or eq_idx + 1 >= len(node.children):
        return None

    init_node = node.children[eq_idx + 1]

    # Check for struct/union initializer list: narrow-check each positional
    # element whose corresponding field is a narrow integer type.
    if (init_node.type == "initializer_list"
            and not has_pointer_declarator(node)
            and not PointerTracker._has_array_declarator(node)):
        struct_name = _get_struct_type_for_decl(node, ptrs)
        if struct_name is not None:
            fields = ptrs.struct_fields_ordered.get(struct_name, [])
            if fields:
                # Skip designated initializers ({.x = val}) — positional only
                has_designator = any(c.type == "initializer_pair"
                                     for c in init_node.children)
                if not has_designator:
                    return _rewrite_struct_init_list(
                        node, init_node, fields, eq_idx, rewriter, ptrs)

    # Get the declared type from the parent declaration
    decl_type = _get_declaration_type(node)
    if decl_type is None or (decl_type not in NARROW_TYPES
                             and decl_type not in ptrs.narrow_type_names):
        return None

    # Skip pointer declarations (char *p = expr doesn't narrow)
    if has_pointer_declarator(node):
        return None

    # Skip if initializer is a simple constant (no narrowing risk)
    if is_const_expr(init_node):
        return None

    # Skip if initializer is an explicit cast to the same type — the cast
    # handler already adds ckd_narrow, so wrapping again would be redundant.
    if init_node.type == "cast_expression":
        ct = _extract_cast_type(init_node)
        if ct == decl_type:
            return None

    # For array declarations, only process brace-enclosed initializer lists
    # (check each element). Skip string literal init (char arr[] = "str").
    if PointerTracker._has_array_declarator(node):
        if init_node.type != "initializer_list":
            return None

    # For brace-enclosed initializer lists ({a, b, c}), wrap each
    # non-constant element individually rather than the whole list.
    if init_node.type == "initializer_list":
        parts = []
        prev_end = init_node.start_byte
        any_changed = False
        for child in init_node.children:
            parts.append(rewriter._strip_markers(prev_end, child.start_byte))
            if (child.type not in ("{", "}", ",", "initializer_list")
                    and not is_const_expr(child)):
                elem_col = child.start_point[1] + 1
                elem_text = transform(child, rewriter, ptrs)
                if elem_text is None:
                    elem_text = rewriter._strip_markers(child.start_byte, child.end_byte)
                parts.append(f"ckd_narrow({elem_text}, {decl_type}, {elem_col})")
                any_changed = True
            else:
                child_text = transform(child, rewriter, ptrs)
                if child_text is not None:
                    parts.append(child_text)
                    any_changed = True
                else:
                    parts.append(rewriter._strip_markers(child.start_byte, child.end_byte))
            prev_end = child.end_byte
        parts.append(rewriter._strip_markers(prev_end, init_node.end_byte))
        if not any_changed:
            return None
        # Rebuild the whole init_declarator with the modified initializer list
        result_parts = []
        for i, child in enumerate(node.children):
            if i > 0:
                result_parts.append(rewriter._strip_markers(node.children[i-1].end_byte, child.start_byte))
            if child is init_node:
                result_parts.append("".join(parts))
            else:
                result_parts.append(rewriter._strip_markers(child.start_byte, child.end_byte))
        return "".join(result_parts)

    col = init_node.start_point[1] + 1

    # Recursively transform the initializer
    init_text = transform(init_node, rewriter, ptrs)
    if init_text is None:
        init_text = rewriter._strip_markers(init_node.start_byte, init_node.end_byte)

    # Build the replacement for the init_declarator: name = ckd_narrow(init, type, col)
    parts = []
    for i, child in enumerate(node.children):
        if i > 0:
            parts.append(rewriter._strip_markers(node.children[i-1].end_byte, child.start_byte))
        if i == eq_idx + 1:
            parts.append(f"ckd_narrow({init_text}, {decl_type}, {col})")
        else:
            parts.append(rewriter._strip_markers(child.start_byte, child.end_byte))
    return "".join(parts)


def try_rewrite_return_narrow(node: Node, rewriter: Rewriter, ptrs: PointerTracker) -> str | None:
    """Wrap the return expression in ckd_narrow if the function returns an integer type."""
    if ptrs.func_return_type is None:
        return None
    if node.has_error or rewriter.is_suppressed(node):
        return None

    # return_statement children: "return", expr, ";"
    expr_node = None
    for child in node.children:
        if child.type not in ("return", ";"):
            expr_node = child
            break

    if expr_node is None:
        return None  # bare "return;"

    if is_const_expr(expr_node):
        return None

    # Skip if return expression is a cast to the same type as the function's
    # return type — the cast handler already adds ckd_narrow.
    ret_type = ptrs.func_return_type
    if (expr_node.type == "cast_expression"
            and _extract_cast_type(expr_node) == ret_type):
        return None

    col = expr_node.start_point[1] + 1

    expr_text = transform(expr_node, rewriter, ptrs)
    if expr_text is None:
        expr_text = rewriter._strip_markers(expr_node.start_byte, expr_node.end_byte)

    # Rebuild: return ckd_narrow(expr, type, col);
    parts = []
    prev_end = node.start_byte
    for child in node.children:
        parts.append(rewriter._strip_markers(prev_end, child.start_byte))
        if child is expr_node:
            parts.append(f"ckd_narrow({expr_text}, {ret_type}, {col})")
        else:
            parts.append(rewriter._strip_markers(child.start_byte, child.end_byte))
        prev_end = child.end_byte
    parts.append(rewriter._strip_markers(prev_end, node.end_byte))
    return "".join(parts)


def try_rewrite_cast_narrow(node: Node, rewriter: Rewriter, ptrs: PointerTracker) -> str | None:
    """Wrap explicit cast in ckd_narrow when the target type is an integer type.
    E.g. (uint8_t)wide_val → ckd_narrow(wide_val, uint8_t, col)."""
    if node.child_count < 4 or node.has_error or rewriter.is_suppressed(node):
        return None

    # Skip file-scope casts — statement expressions aren't valid there.
    parent = node.parent
    inside_function = False
    while parent is not None:
        if parent.type == "compound_statement":
            inside_function = True
            break
        if parent.type == "translation_unit":
            break
        parent = parent.parent
    if not inside_function:
        return None

    # cast_expression: '(' type_descriptor ')' operand
    type_desc = None
    operand = None
    for child in node.children:
        if child.type == "type_descriptor":
            type_desc = child
        elif child.type not in ("(", ")") and type_desc is not None:
            operand = child
            break

    if type_desc is None or operand is None:
        return None

    # Skip pointer casts: (void *)x, (char *)x
    for child in type_desc.children:
        if child.type == "abstract_pointer_declarator":
            return None

    # Extract the target type
    cast_type = None
    for child in type_desc.children:
        if child.type in ("primitive_type", "sized_type_specifier"):
            cast_type = node_text(child)
        elif child.type == "type_identifier":
            cast_type = node_text(child)

    if cast_type is None:
        return None
    if cast_type not in NARROW_TYPES and cast_type not in ptrs.narrow_type_names:
        return None

    # Skip constant operands
    if is_const_expr(operand):
        return None

    col = node.start_point[1] + 1

    operand_text = transform(operand, rewriter, ptrs)
    if operand_text is None:
        operand_text = rewriter._strip_markers(operand.start_byte, operand.end_byte)

    return f"ckd_narrow({operand_text}, {cast_type}, {col})"


def try_rewrite_call_narrow(node: Node, rewriter: Rewriter, ptrs: PointerTracker) -> str | None:
    """Wrap function call arguments in ckd_narrow when the declared parameter type
    is an integer type. E.g. void f(int x); f(long_val) → f(ckd_narrow(long_val, int, col))."""
    if node.child_count < 2 or node.has_error:
        return None

    # call_expression: func_name argument_list
    func_node = node.children[0]
    if func_node.type != "identifier":
        return None  # skip function pointer calls, method calls, etc.

    func_name = node_text(func_node)
    param_types = ptrs.func_param_narrow.get(func_name)
    if param_types is None:
        return None  # no narrow params known for this function

    # Find argument_list
    arg_list = None
    for child in node.children:
        if child.type == "argument_list":
            arg_list = child
            break
    if arg_list is None:
        return None

    # Collect actual argument nodes (skip punctuation)
    args = [c for c in arg_list.children if c.type not in ("(", ")", ",")]

    # Check if any argument needs narrowing
    any_narrow = False
    for i, arg in enumerate(args):
        if i < len(param_types) and param_types[i] is not None and not is_const_expr(arg):
            any_narrow = True
            break
    if not any_narrow:
        return None

    # Rebuild the call with narrowed arguments
    parts = []
    arg_idx = 0
    prev_end = arg_list.start_byte
    for i, child in enumerate(arg_list.children):
        # Gap before this child
        parts.append(rewriter._strip_markers(prev_end, child.start_byte))

        if child.type not in ("(", ")", ","):
            decl_type = param_types[arg_idx] if arg_idx < len(param_types) else None
            arg_idx += 1
            if (decl_type is not None
                    and not is_const_expr(child)
                    and not (child.type == "cast_expression"
                             and _extract_cast_type(child) == decl_type)):
                col = child.start_point[1] + 1
                arg_text = transform(child, rewriter, ptrs)
                if arg_text is None:
                    arg_text = rewriter._strip_markers(child.start_byte, child.end_byte)
                parts.append(f"ckd_narrow({arg_text}, {decl_type}, {col})")
            else:
                child_text = transform(child, rewriter, ptrs)
                if child_text is not None:
                    parts.append(child_text)
                else:
                    parts.append(rewriter._strip_markers(child.start_byte, child.end_byte))
        else:
            parts.append(rewriter._strip_markers(child.start_byte, child.end_byte))

        prev_end = child.end_byte
    parts.append(rewriter._strip_markers(prev_end, arg_list.end_byte))

    # Rebuild: func_name + rewritten_arg_list
    func_text = rewriter._strip_markers(func_node.start_byte, func_node.end_byte)
    gap = rewriter._strip_markers(func_node.end_byte, arg_list.start_byte)
    return func_text + gap + "".join(parts)


def try_rewrite_unary_neg(node: Node, rewriter: Rewriter, ptrs: PointerTracker) -> str | None:
    """Rewrite unary negation -x to check for signed overflow (e.g. -INT_MIN).
    Returns rewritten text or None."""
    if node.child_count < 2 or node.has_error or rewriter.is_suppressed(node):
        return None

    children = node.children
    if children[0].type != "-":
        return None

    operand = children[1]

    # Skip constant expressions (negating a literal is always fine)
    if is_const_expr(operand):
        return None

    col = node.start_point[1] + 1

    operand_text = transform(operand, rewriter, ptrs)
    if operand_text is None:
        operand_text = rewriter._strip_markers(operand.start_byte, operand.end_byte)

    return f"ckd_neg({operand_text}, {col})"


