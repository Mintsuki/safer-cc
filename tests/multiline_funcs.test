=== multiline condition ===
void f(int a, int b) {
    if (a + b
        > 100) {
        a++;
    }
}
---
void f(int a, int b) {
    if (ckd_add(a, b, 9)
        > 100) {
        ckd_preinc(a, 9);
    }
}






=== switch with arith ===
int f(int op, int a, int b) {
    switch (op) {
    case 0: return a + b;
    case 1: return a - b;
    case 2: return a * b;
    default: return 0;
    }
}
---
int f(int op, int a, int b) {
    switch (op) {
    case 0: return ckd_narrow(ckd_add(a, b, 20), int, 20);
    case 1: return ckd_narrow(ckd_sub(a, b, 20), int, 20);
    case 2: return ckd_narrow(ckd_mul(a, b, 20), int, 20);
    default: return 0;
    }
}





