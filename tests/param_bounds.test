=== param array basic ===
void f(int arr[10], int i) { arr[i]; }
---
void f(int arr[10], int i) { ckd_bounds(arr, i, 10, 30); }






=== param array static ===
void f(char buf[static 128], int i) { buf[i]; }
---
void f(char buf[static 128], int i) { ckd_bounds(buf, i, 128, 39); }






=== param array write ===
void f(int arr[8], int i, int v) { arr[i] = v; }
---
void f(int arr[8], int i, int v) { ckd_bounds(arr, i, 8, 36) = ckd_narrow(v, int, 45); }






=== param array unsized no check ===
void f(int arr[], int i) { arr[i]; }
---
void f(int arr[], int i) { arr[i]; }






=== param pointer no check ===
void f(int *arr, int i) { arr[i]; }
---
void f(int *arr, int i) { arr[i]; }






=== param vla size ===
void f(int n, int arr[n], int i) { arr[i]; }
---
void f(int n, int arr[n], int i) { ckd_bounds(arr, i, n, 36); }






=== param array 2d ===
void f(int m[4][4], int i, int j) { m[i][j]; }
---
void f(int m[4][4], int i, int j) { ckd_bounds(ckd_bounds(m, i, 4, 37), j, 4, 37); }






=== param array narrow with bounds ===
typedef unsigned char uint8_t;
void f(uint8_t buf[256], int i, int x) {
    buf[i] = x;
}
---
typedef unsigned char uint8_t;
void f(uint8_t buf[256], int i, int x) {
    ckd_bounds(buf, i, 256, 5) = ckd_narrow(x, uint8_t, 14);
}






=== param array compound ===
void f(int arr[10], int i, int v) {
    arr[i] += v;
}
---
void f(int arr[10], int i, int v) {
    ckd_compound_narrow(ckd_bounds(arr, i, 10, 5), ckd_add, v, int, 5);
}




=== param array arith index ===
void f(int arr[16], int i) { arr[i + 1]; }
---
void f(int arr[16], int i) { ckd_bounds(arr, ckd_add(i, 1, 34), 16, 30); }






=== param array of ptrs ===
void f(char *arr[10], int i) { arr[i]; }
---
void f(char *arr[10], int i) { ckd_bounds(arr, i, 10, 32); }






=== param static narrow ===
typedef unsigned char uint8_t;
void f(uint8_t data[static 64], int i) {
    uint8_t v = data[i];
}
---
typedef unsigned char uint8_t;
void f(uint8_t data[static 64], int i) {
    uint8_t v = ckd_narrow(ckd_bounds(data, i, 64, 17), uint8_t, 17);
}





