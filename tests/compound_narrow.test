=== char compound add ===
void f(int x) { char c = 0; c += x; }
---
void f(int x) { char c = 0; ckd_compound_narrow(c, ckd_add, x, char, 29); }






=== unsigned char compound add ===
void f(int x) { unsigned char u = 0; u += x; }
---
void f(int x) { unsigned char u = 0; ckd_compound_narrow(u, ckd_add, x, unsigned char, 38); }






=== short compound sub ===
void f(int x) { short s = 0; s -= x; }
---
void f(int x) { short s = 0; ckd_compound_narrow(s, ckd_sub, x, short, 30); }






