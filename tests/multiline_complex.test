=== three nested parens ===
int f(int a, int b, int c, int d) {
    return ((a + b) * (c - d)) + 1;
}
---
int f(int a, int b, int c, int d) {
    return ckd_narrow(ckd_add((ckd_mul((ckd_add(a, b, 14)), (ckd_sub(c, d, 24)), 13)), 1, 12), int, 12);
}





=== conditional across lines ===
int f(int a, int b, int c) {
    return a > 0
        ? a + b
        : a - c;
}
---
int f(int a, int b, int c) {
    return ckd_narrow(a > 0
        ? ckd_add(a, b, 11)
        : ckd_sub(a, c, 11), int, 12);
}





