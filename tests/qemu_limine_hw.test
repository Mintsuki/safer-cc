=== edid mode byte ===
typedef unsigned char uint8_t;
void f(uint8_t *mode, unsigned xres) {
    mode[0] = xres / 8 - 31;
}
---
typedef unsigned char uint8_t;
void f(uint8_t *mode, unsigned xres) {
    mode[0] = ckd_narrow(ckd_sub(ckd_div(xres, 8, 15), 31, 15), uint8_t, 15);
}






=== edid timing calc ===
void f(unsigned xres, unsigned *xfront) {
    *xfront = xres * 25 / 100;
}
---
void f(unsigned xres, unsigned *xfront) {
    *xfront = ckd_narrow(ckd_div(ckd_mul(xres, 25, 15), 100, 15), unsigned, 15);
}






=== ati dst calc ===
void f(unsigned x, unsigned w) {
    unsigned dst_x = x + 1 - w;
}
---
void f(unsigned x, unsigned w) {
    unsigned dst_x = ckd_narrow(ckd_sub(ckd_add(x, 1, 22), w, 22), unsigned, 22);
}





=== ati bpp div ===
void f(int bpp) {
    unsigned bypp = bpp / 8;
}
---
void f(int bpp) {
    unsigned bypp = ckd_narrow(ckd_div(bpp, 8, 21), unsigned, 21);
}






=== ati stride mul ===
void f(unsigned *stride, int bpp) {
    *stride *= bpp;
}
---
void f(unsigned *stride, int bpp) {
    ckd_compound_narrow(*stride, ckd_mul, bpp, unsigned, 5);
}




