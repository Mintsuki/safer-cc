=== compound add int ===
void f(int a, int b) { a += b; }
---
void f(int a, int b) { ckd_compound_narrow(a, ckd_add, b, int, 24); }




=== compound sub int ===
void f(int a, int b) { a -= b; }
---
void f(int a, int b) { ckd_compound_narrow(a, ckd_sub, b, int, 24); }




=== compound mul int ===
void f(int a, int b) { a *= b; }
---
void f(int a, int b) { ckd_compound_narrow(a, ckd_mul, b, int, 24); }




=== compound div int ===
void f(int a, int b) { a /= b; }
---
void f(int a, int b) { ckd_compound_narrow(a, ckd_div, b, int, 24); }




=== compound mod int ===
void f(int a, int b) { a %= b; }
---
void f(int a, int b) { ckd_compound_narrow(a, ckd_mod, b, int, 24); }




=== compound shl ===
void f(int a, int b) { a <<= b; }
---
void f(int a, int b) { ckd_compound_narrow(a, ckd_shl, b, int, 24); }




=== compound shr ===
