=== add assign ===
void f(int a) { a += 5; }
---
void f(int a) { ckd_compound_narrow(a, ckd_add, 5, int, 17); }




=== sub assign ===
void f(int a) { a -= 5; }
---
void f(int a) { ckd_compound_narrow(a, ckd_sub, 5, int, 17); }




=== mul assign ===
void f(int a) { a *= 5; }
---
void f(int a) { ckd_compound_narrow(a, ckd_mul, 5, int, 17); }




=== div assign ===
void f(int a) { a /= 5; }
---
void f(int a) { ckd_compound_narrow(a, ckd_div, 5, int, 17); }




=== mod assign ===
void f(int a) { a %= 5; }
---
void f(int a) { ckd_compound_narrow(a, ckd_mod, 5, int, 17); }




=== shl assign ===
void f(int a) { a <<= 1; }
---
void f(int a) { ckd_compound_narrow(a, ckd_shl, 1, int, 17); }




=== shr assign ===
void f(int a) { a >>= 1; }
---
void f(int a) { ckd_compound_narrow(a, ckd_shr, 1, int, 17); }




=== ptr add assign ===
void f(char *p) { p += 5; }
---
void f(char *p) { ckd_compound(p, ckd_ptr_add, 5, 19); }






=== ptr sub assign ===
void f(char *p) { p -= 5; }
---
void f(char *p) { ckd_compound(p, ckd_ptr_sub, 5, 19); }






=== compound with arith rhs ===
void f(int x, int a, int b) { x += a * b; }
---
void f(int x, int a, int b) { ckd_compound_narrow(x, ckd_add, ckd_mul(a, b, 36), int, 31); }




=== compound div with expr ===
void f(int x, int a, int b) { x /= a + b; }
---
void f(int x, int a, int b) { ckd_compound_narrow(x, ckd_div, ckd_add(a, b, 36), int, 31); }




=== compound shl with expr ===
void f(unsigned x, int n) { x <<= n + 1; }
---
void f(unsigned x, int n) { ckd_compound_narrow(x, ckd_shl, ckd_add(n, 1, 35), unsigned, 29); }




=== suppress compound ===
void f(int x) { x @+= 1; x @/= 2; x @<<= 3; }
---
void f(int x) { x += 1; x /= 2; x <<= 3; }






=== bounds compound ===
void f(int i) { int arr[10]; arr[i] += 5; arr[i] *= 2; arr[i] /= 3; }
---
void f(int i) { int arr[10]; ckd_compound_narrow(ckd_bounds(arr, i, 10, 30), ckd_add, 5, int, 30); ckd_compound_narrow(ckd_bounds(arr, i, 10, 43), ckd_mul, 2, int, 43); ckd_compound_narrow(ckd_bounds(arr, i, 10, 56), ckd_div, 3, int, 56); }



