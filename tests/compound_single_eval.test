=== deref compound single eval ===
void f(unsigned *idx, unsigned n) { *idx += n; }
---
void f(unsigned *idx, unsigned n) { ckd_compound_narrow(*idx, ckd_add, n, unsigned, 37); }




=== subscript compound single eval ===
void f(int *arr, int v) { arr[0] += v; }
---
void f(int *arr, int v) { ckd_compound_narrow(arr[0], ckd_add, v, int, 27); }




=== ptr inc single eval ===
void f(int *p) { (*p)++; }
---
void f(int *p) { ckd_preinc((*p), 18); }






=== ptr dec single eval ===
void f(int *p) { (*p)--; }
---
void f(int *p) { ckd_predec((*p), 18); }






=== ptr postinc single eval ===
