=== division and modulo only ===
int f(int a, int b) {
    int q = a / b;
    int r = a % b;
    a /= b;
    a %= b;
    return q + r;
}
---
int f(int a, int b) {
    int q = ckd_narrow(ckd_div(a, b, 13), int, 13);
    int r = ckd_narrow(ckd_mod(a, b, 13), int, 13);
    ckd_compound_narrow(a, ckd_div, b, int, 5);
    ckd_compound_narrow(a, ckd_mod, b, int, 5);
    return ckd_narrow(ckd_add(q, r, 12), int, 12);
}


