=== add ===
void f(int a, int b) { int x = a + b; }
---
void f(int a, int b) { int x = ckd_narrow(ckd_add(a, b, 32), int, 32); }





=== sub ===
void f(int a, int b) { int x = a - b; }
---
void f(int a, int b) { int x = ckd_narrow(ckd_sub(a, b, 32), int, 32); }





=== mul ===
void f(int a, int b) { int x = a * b; }
---
void f(int a, int b) { int x = ckd_narrow(ckd_mul(a, b, 32), int, 32); }





=== add= ===
void f(int a) { a += 1; }
---
void f(int a) { ckd_compound_narrow(a, ckd_add, 1, int, 17); }




=== sub= ===
void f(int a) { a -= 1; }
---
void f(int a) { ckd_compound_narrow(a, ckd_sub, 1, int, 17); }




=== mul= ===
void f(int a) { a *= 1; }
---
void f(int a) { ckd_compound_narrow(a, ckd_mul, 1, int, 17); }




=== preinc ===
void f(int a) { ++a; }
---
void f(int a) { ckd_preinc(a, 17); }






=== predec ===
void f(int a) { --a; }
---
void f(int a) { ckd_predec(a, 17); }






=== postinc disc ===
void f(int a) { a++; }
---
void f(int a) { ckd_preinc(a, 17); }






=== postdec disc ===
void f(int a) { a--; }
---
void f(int a) { ckd_predec(a, 17); }






=== postinc used ===
void f(int a) { int b = a++; }
---
void f(int a) { int b = ckd_narrow(ckd_postinc(a, 25), int, 25); }






=== postdec used ===
void f(int a) { int b = a--; }
---
void f(int a) { int b = ckd_narrow(ckd_postdec(a, 25), int, 25); }






=== ptr add ===
