=== three structs same field ===
struct x { char c; };
struct y { short c; };
struct z { int c; };
void f(struct x *x, struct y *y, struct z *z, int v) {
    x->c = v;
    y->c = v;
    z->c = v;
}
---
struct x { char c; };
struct y { short c; };
struct z { int c; };
void f(struct x *x, struct y *y, struct z *z, int v) {
    x->c = ckd_narrow(v, char, 12);
    y->c = ckd_narrow(v, short, 12);
    z->c = ckd_narrow(v, int, 12);
}





