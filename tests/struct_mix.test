=== struct multiple fields multiline ===
struct color { unsigned char r; unsigned char g; unsigned char b; unsigned char a; };
void f(struct color *c, int rv, int gv, int bv, int av) {
    c->r = rv;
    c->g = gv;
    c->b = bv;
    c->a = av;
}
---
struct color { unsigned char r; unsigned char g; unsigned char b; unsigned char a; };
void f(struct color *c, int rv, int gv, int bv, int av) {
    c->r = ckd_narrow(rv, unsigned char, 12);
    c->g = ckd_narrow(gv, unsigned char, 12);
    c->b = ckd_narrow(bv, unsigned char, 12);
    c->a = ckd_narrow(av, unsigned char, 12);
}






=== struct field from neg ===
struct s { char neg; };
void f(struct s *s, int x) {
    s->neg = -x;
}
---
struct s { char neg; };
void f(struct s *s, int x) {
    s->neg = ckd_narrow(ckd_neg(x, 14), char, 14);
}






=== struct field from mod ===
