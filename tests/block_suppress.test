=== block suppress basic ===
void f(int a, int b) {
    int x = a + b;
    @@@
    int y = a + b;
    @@@
    int z = a + b;
}
---
void f(int a, int b) {
    int x = ckd_narrow(ckd_add(a, b, 13), int, 13);

    int y = a + b;

    int z = ckd_narrow(ckd_add(a, b, 13), int, 13);
}

=== block suppress to eof ===
void f(int a, int b) {
    int x = a + b;
}
@@@
void g(int a, int b) {
    int y = a + b;
}
---
void f(int a, int b) {
    int x = ckd_narrow(ckd_add(a, b, 13), int, 13);
}

void g(int a, int b) {
    int y = a + b;
}


=== block suppress with other ops ===
void f(int a, int b) {
    @@@
    int x = a * b;
    int y = a - b;
    @@@
    int z = a / b;
}
---
void f(int a, int b) {

    int x = a * b;
    int y = a - b;

    int z = ckd_narrow(ckd_div(a, b, 13), int, 13);
}

