=== align up ===
void f(unsigned long v, unsigned long a) { unsigned long r = ((v + (a - 1)) / a) * a; }
---
void f(unsigned long v, unsigned long a) { unsigned long r = ckd_narrow(ckd_mul((ckd_div((ckd_add(v, (ckd_sub(a, 1, 69)), 64)), a, 63)), a, 62), unsigned long, 62); }





=== base+len ===
void f(unsigned long b, unsigned long l) { unsigned long t = b + l; }
---
void f(unsigned long b, unsigned long l) { unsigned long t = ckd_narrow(ckd_add(b, l, 62), unsigned long, 62); }





=== count*sizeof ===
void f(unsigned long n) { unsigned long s = n * sizeof(int); }
---
