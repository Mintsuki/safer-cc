=== 2d read ===
void f(int i, int j) { int m[3][4]; int x = m[i][j]; }
---
void f(int i, int j) { int m[3][4]; int x = ckd_narrow(ckd_bounds(ckd_bounds(m, i, 3, 45), j, 4, 45), int, 45); }






=== 2d write ===
void f(int i, int j) { int m[3][4]; m[i][j] = 0; }
---
void f(int i, int j) { int m[3][4]; ckd_bounds(ckd_bounds(m, i, 3, 37), j, 4, 37) = 0; }






=== 2d const indices ===
void f(void) { int m[3][4]; int x = m[1][2]; }
---
void f(void) { int m[3][4]; int x = ckd_narrow(ckd_bounds(ckd_bounds(m, 1, 3, 37), 2, 4, 37), int, 37); }






=== 2d first only ===
void f(int i) { int m[3][4]; int *row = m[i]; }
---
void f(int i) { int m[3][4]; int *row = ckd_bounds(m, i, 3, 41); }






=== 2d field access ===
struct v { int x; int y; }; void f(int i) { struct v pts[8][2]; pts[i][0].x = 1; }
---
struct v { int x; int y; }; void f(int i) { struct v pts[8][2]; ckd_bounds(ckd_bounds(pts, i, 8, 65), 0, 2, 65).x = 1; }






=== 3d array ===
void f(int i, int j, int k) { int a[2][3][4]; int x = a[i][j][k]; }
---
void f(int i, int j, int k) { int a[2][3][4]; int x = ckd_narrow(ckd_bounds(ckd_bounds(ckd_bounds(a, i, 2, 55), j, 3, 55), k, 4, 55), int, 55); }





