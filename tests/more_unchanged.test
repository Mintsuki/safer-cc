=== plain assign ===
void f(int a) { int x = a; }
---
void f(int a) { int x = ckd_narrow(a, int, 25); }






=== div assign ===
void f(int a) { a /= 2; }
---
void f(int a) { ckd_compound_narrow(a, ckd_div, 2, int, 17); }




=== mod assign ===
void f(int a) { a %= 2; }
---
void f(int a) { ckd_compound_narrow(a, ckd_mod, 2, int, 17); }




