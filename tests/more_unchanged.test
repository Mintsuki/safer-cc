=== comma no arith ===
void f(int a, int b) { a, b; }
---
void f(int a, int b) { a, b; }






=== ternary no arith ===
void f(int c, int a, int b) { int x = c ? a : b; }
---
void f(int c, int a, int b) { int x = ckd_narrow(c ? a : b, int, 39); }





