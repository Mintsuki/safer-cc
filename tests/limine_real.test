=== segment ptr calc ===
void f(unsigned short seg, unsigned short off) { char *p = (char *)(unsigned long)(((unsigned long)seg << 4) + (unsigned long)off); }
---
void f(unsigned short seg, unsigned short off) { char *p = (char *)ckd_narrow((ckd_add((ckd_shl(ckd_narrow(seg, unsigned long, 85), 4, 85)), ckd_narrow(off, unsigned long, 112), 84)), unsigned long, 68); }

=== dmap offset ===
void f(void *addr, unsigned long dmap_off) { unsigned long va = (unsigned long)addr + dmap_off; }
---
void f(void *addr, unsigned long dmap_off) { unsigned long va = ckd_narrow(ckd_add(ckd_narrow(addr, unsigned long, 65), dmap_off, 65), unsigned long, 65); }

=== title skip ===
void f(int i, int title_length) { i += (title_length + 2) - 1; }
---
void f(int i, int title_length) { ckd_compound_narrow(i, ckd_add, ckd_sub((ckd_add(title_length, 2, 41)), 1, 40), int, 35); }




=== madt walk ===
void f(unsigned char *ptr) { ptr += *(ptr + 1); }
---
void f(unsigned char *ptr) { ckd_compound(ptr, ckd_ptr_add, *(ckd_ptr_add(ptr, 1, 39)), 30); }






