=== size check ===
void f(char *fd, unsigned long size, unsigned long loc, unsigned long count) { if (loc >= size || count > size - loc) { return; } char *p = fd + loc; }
---
void f(char *fd, unsigned long size, unsigned long loc, unsigned long count) { if (loc >= size || count > ckd_sub(size, loc, 107)) { return; } char *p = ckd_ptr_add(fd, loc, 141); }






