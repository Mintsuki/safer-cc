=== unsigned char ===
void f(unsigned char a, unsigned char b) { unsigned char c = a + b; }
---
void f(unsigned char a, unsigned char b) { unsigned char c = ckd_narrow(ckd_add(a, b, 62), unsigned char, 62); }






