=== char return ===
char f(int x) { return x; }
---
char f(int x) { return ckd_narrow(x, char, 24); }






=== unsigned char return ===
unsigned char f(int x) { return x; }
---
unsigned char f(int x) { return ckd_narrow(x, unsigned char, 33); }






=== short return ===
short f(int x) { return x; }
---
short f(int x) { return ckd_narrow(x, short, 25); }






=== typedef return ===
typedef unsigned char uint8_t;
uint8_t f(int x) { return x; }
---
typedef unsigned char uint8_t;
uint8_t f(int x) { return ckd_narrow(x, uint8_t, 27); }






